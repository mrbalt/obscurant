ac_add_options --enable-application=browser
ac_add_options --with-branding=browser/branding/obscurant
mk_add_options MOZ_OBJDIR=@OBJDIR@

ac_add_options --enable-bootstrap
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --enable-linker=lld
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-webspeech
ac_add_options --disable-synth-speechd
ac_add_options --disable-parental-controls
ac_add_options --disable-necko-wifi
ac_add_options --disable-negotiateauth
ac_add_options --disable-jxl
ac_add_options --disable-backgroundtasks
ac_add_options --disable-webdriver
mk_add_options MOZ_PARALLEL_BUILD=10
ac_add_options --with-app-basename=Obscurant
mk_add_options MOZ_REQUIRE_SIGNING=1
export MOZ_REQUIRE_SIGNING=1
export CFLAGS="-fcf-protection=full -ffile-prefix-map=@HOME@=/build -fdebug-prefix-map=@HOME@=/build"
export CXXFLAGS="-fcf-protection=full -ffile-prefix-map=@HOME@=/build -fdebug-prefix-map=@HOME@=/build"
export RUSTFLAGS="--remap-path-prefix=@HOME@=/build"
