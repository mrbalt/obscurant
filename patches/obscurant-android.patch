+
+private const val ENGINES = "privacy.trackingprotection.content.protection.engines"
+private const val ENGINES_PRIVATE = "privacy.trackingprotection.content.protection.engines.pbmode"
+private const val ADS_ENGINE = "test_block"
+private const val PHISHING_ENGINE = "test_phish"
+private const val ADS_KEY = "obscurant_shield_ads"
+private const val PHISHING_KEY = "obscurant_shield_phishing"
+private const val FINGERPRINT_KEY = "obscurant_shield_fingerprint"
+private const val GPC_KEY = "obscurant_shield_gpc"
+
+@OptIn(ExperimentalAndroidComponentsApi::class)
+private fun setEnginePref(context: Context, name: String, text: String? = null, flag: Boolean? = null) {
+    val runtime = context.components.core.engine as? BrowserPreferencesRuntime ?: return
+    val failed: (Throwable) -> Unit = { Logger("ObscurantShields").error("could not set $name", it) }
+    if (text != null) {
+        runtime.setBrowserPref(name, text, Branch.USER, {}, failed)
+    } else if (flag != null) {
+        runtime.setBrowserPref(name, flag, Branch.USER, {}, failed)
+    }
+}
+
+private fun applyBlocker(context: Context, ads: Boolean, phishing: Boolean) {
+    val engines = listOfNotNull(ADS_ENGINE.takeIf { ads }, PHISHING_ENGINE.takeIf { phishing }).joinToString(",")
+    setEnginePref(context, ENGINES, text = engines)
+    setEnginePref(context, ENGINES_PRIVATE, text = engines)
+}
+
+/** The Obscurant shield switches shown in the site panel. These apply to every site. */
+@Composable
+internal fun ObscurantShieldsGroup() {
+    val context = LocalContext.current
+    val prefs = remember { PreferenceManager.getDefaultSharedPreferences(context.applicationContext) }
+    var ads by remember { mutableStateOf(prefs.getBoolean(ADS_KEY, true)) }
+    var phishing by remember { mutableStateOf(prefs.getBoolean(PHISHING_KEY, true)) }
+    var fingerprint by remember { mutableStateOf(prefs.getBoolean(FINGERPRINT_KEY, true)) }
+    var privacySignal by remember { mutableStateOf(prefs.getBoolean(GPC_KEY, true)) }
+
+    MenuGroup {
+        Column(modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp)) {
+            Text(
+                text = "Obscurant Shields (all sites)",
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp),
+            )
+            ShieldSwitch("Block ads and trackers", ads) {
+                ads = it
+                prefs.edit().putBoolean(ADS_KEY, it).apply()
+                applyBlocker(context, it, phishing)
+            }
+            ShieldSwitch("Block phishing sites", phishing) {
+                phishing = it
+                prefs.edit().putBoolean(PHISHING_KEY, it).apply()
+                applyBlocker(context, ads, it)
+            }
+            ShieldSwitch("Resist fingerprinting", fingerprint) {
+                fingerprint = it
+                prefs.edit().putBoolean(FINGERPRINT_KEY, it).apply()
+                setEnginePref(context, "privacy.fingerprintingProtection", flag = it)
+            }
+            ShieldSwitch("Ask sites not to sell my data", privacySignal) {
+                privacySignal = it
+                prefs.edit().putBoolean(GPC_KEY, it).apply()
+                setEnginePref(context, "privacy.globalprivacycontrol.enabled", flag = it)
+            }
+        }
+    }
+}
+
+@Composable
+private fun ShieldSwitch(label: String, checked: Boolean, onChange: (Boolean) -> Unit) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .toggleable(value = checked, role = Role.Switch, onValueChange = onChange)
+            .padding(horizontal = 16.dp, vertical = 6.dp),
+        horizontalArrangement = Arrangement.SpaceBetween,
