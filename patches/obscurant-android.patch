+package org.mozilla.fenix.utils
+
+import android.content.Context
+import android.net.Uri
+import android.os.SystemClock
+import android.widget.Toast
+import androidx.preference.PreferenceManager
+import mozilla.components.concept.engine.EngineSession
+import org.mozilla.fenix.ext.components
+
+/**
+ * Keeps Google signed in only inside its own container, the same way the desktop browser does: when the
+ * user opens a Google site from a normal tab, the page is opened in a tab with a separate cookie jar before
+ * anything is sent. Private tabs are left alone, and only user started navigations are moved.
+ */
+object ObscurantGoogleContainer {
+    const val ENABLED_PREF = "pref_key_obscurant_google_container"
+    private const val CONTEXT_ID = "obscurant_google"
+    private const val TOLD_PREF = "obscurant_google_container_told"
+    private const val WINDOW_MS = 10_000L
+    private const val MAX_MOVES = 3
+    private val domains = listOf(
+        "google.com",
+        "youtube.com",
+        "gstatic.com",
+        "googleusercontent.com",
+        "googleapis.com",
+        "ggpht.com",
+        "gmail.com",
+    )
+    private val recent = mutableMapOf<String, MutableList<Long>>()
+
+    private fun isGoogleUrl(url: String): Boolean {
+        val uri = Uri.parse(url)
+        val host = uri.host?.lowercase() ?: return false
+        return uri.scheme == "https" && domains.any { host == it || host.endsWith(".$it") }
+    }
+
+    /** Returns true when [url] was moved to the Google container and must not load in [engineSession]. */
+    fun move(context: Context, engineSession: EngineSession, url: String, userStarted: Boolean): Boolean {
+        val prefs = PreferenceManager.getDefaultSharedPreferences(context.applicationContext)
+        if (!userStarted || !isGoogleUrl(url) || !prefs.getBoolean(ENABLED_PREF, true)) {
+            return false
+        }
+        val store = context.components.core.store
+        val tab = store.state.tabs.firstOrNull { it.engineState.engineSession === engineSession }
+        if (tab == null || tab.content.private || tab.contextId == CONTEXT_ID) {
+            return false
+        }
+        val now = SystemClock.elapsedRealtime()
+        val moves = recent.getOrPut(tab.id) { mutableListOf() }
+        moves.removeAll { now - it > WINDOW_MS }
+        if (moves.size >= MAX_MOVES) {
+            return false
+        }
+        moves.add(now)
+
+        val selected = store.state.selectedTabId == tab.id
+        val blank = tab.content.url.isEmpty() || tab.content.url == "about:blank" || tab.content.url == url
+        val tabs = context.components.useCases.tabsUseCases
+        tabs.addTab(url = url, selectTab = selected, parentId = if (blank) null else tab.id, contextId = CONTEXT_ID)
+        if (blank) {
+            tabs.removeTab(tab.id)
+        }
+        if (!prefs.getBoolean(TOLD_PREF, false)) {
+            prefs.edit().putBoolean(TOLD_PREF, true).apply()
+            Toast.makeText(context, "Google opens in its own container", Toast.LENGTH_LONG).show()
+        }
+        return true
+    }
+}
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/ObscurantUpdate.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/ObscurantUpdate.kt
@@ -0,0 +1,72 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.utils
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.widget.Toast
+import androidx.preference.PreferenceManager
+import org.json.JSONArray
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * Tells the user when a newer Obscurant for Android exists. It only reads the public release list on GitHub
+ * (about once a day) and shows a notice. It never downloads or installs anything. Can be switched off in Settings.
+ */
+object ObscurantUpdate {
+    const val ENABLED_PREF = "pref_key_obscurant_update_check"
+    private const val LAST_PREF = "obscurant_update_last_check"
+    private const val BUILD = 5
+    private const val DAY_MS = 24L * 60 * 60 * 1000
+    private const val TIMEOUT_MS = 12000
+    private const val HTTP_OK = 200
+    private val tagPattern = Regex("^android-[0-9.]+-([0-9]+)$")
+
+    @Suppress("TooGenericExceptionCaught")
+    fun maybeCheck(context: Context) {
+        val app = context.applicationContext
+        val prefs = PreferenceManager.getDefaultSharedPreferences(app)
+        val now = System.currentTimeMillis()
+        if (!prefs.getBoolean(ENABLED_PREF, true) || now - prefs.getLong(LAST_PREF, 0L) < DAY_MS) {
+            return
+        }
+        prefs.edit().putLong(LAST_PREF, now).apply()
+        Thread {
+            try {
+                val connection = URL("https://api.github.com/repos/mrbalt/obscurant/releases?per_page=10")
+                    .openConnection() as HttpURLConnection
+                connection.connectTimeout = TIMEOUT_MS
+                connection.readTimeout = TIMEOUT_MS
+                try {
+                    if (connection.responseCode == HTTP_OK) {
+                        val releases = JSONArray(connection.inputStream.bufferedReader().readText())
+                        var newest = 0
+                        for (i in 0 until releases.length()) {
+                            val tag = releases.getJSONObject(i).optString("tag_name")
+                            tagPattern.matchEntire(tag)?.groupValues?.get(1)?.toIntOrNull()?.let {
+                                if (it > newest) newest = it
+                            }
+                        }
+                        if (newest > BUILD) {
+                            Handler(Looper.getMainLooper()).post {
+                                Toast.makeText(
+                                    app,
+                                    "A newer Obscurant is available. Settings, Obscurant updates.",
+                                    Toast.LENGTH_LONG,
+                                ).show()
+                            }
+                        }
+                    }
+                } finally {
+                    connection.disconnect()
+                }
+            } catch (e: Exception) {
+                // No notice if the check fails.
+            }
+        }.start()
+    }
+}
