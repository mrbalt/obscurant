+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.app.AppCompatDelegate
+import androidx.compose.material3.ColorScheme
+import androidx.compose.ui.graphics.Color
+import androidx.preference.PreferenceManager
+import org.mozilla.fenix.ext.components
+
+/** One desktop Obscurant theme, as used by the Android app. */
+internal data class ObscurantPalette(
+    val name: String,
+    val isLight: Boolean,
+    val frame: Long,
+    val toolbar: Long,
+    val field: Long,
+    val text: Long,
+    val subtext: Long,
+    val accent: Long,
+    val onAccent: Long,
+    val soft: Long,
+    val border: Long,
+    @param:StyleRes val overlay: Int,
+)
+
+internal const val OBSCURANT_DEFAULT_THEME = "Obscurant"
+private const val THEME_PREF = "obscurant_theme_name"
+
+/** Reads, applies and lets the user pick an Obscurant theme. */
+object ObscurantThemes {
+    internal fun savedName(context: Context): String =
+        PreferenceManager.getDefaultSharedPreferences(context.applicationContext)
+            .getString(THEME_PREF, OBSCURANT_DEFAULT_THEME) ?: OBSCURANT_DEFAULT_THEME
+
+    internal fun current(context: Context): ObscurantPalette? {
+        val name = savedName(context)
+        return obscurantPalettes.firstOrNull { it.name == name }
+    }
+
+    internal fun apply(base: ColorScheme, p: ObscurantPalette): ColorScheme = base.copy(
+        primary = Color(p.accent),
+        onPrimary = Color(p.onAccent),
+        primaryContainer = Color(p.soft),
+        onPrimaryContainer = Color(p.text),
+        inversePrimary = Color(p.accent),
+        secondary = Color(p.subtext),
+        onSecondary = Color(p.frame),
+        secondaryContainer = Color(p.field),
+        onSecondaryContainer = Color(p.text),
+        tertiary = Color(p.accent),
+        onTertiary = Color(p.onAccent),
+        tertiaryContainer = Color(p.soft),
+        onTertiaryContainer = Color(p.text),
+        background = Color(p.frame),
+        onBackground = Color(p.text),
+        surface = Color(p.toolbar),
+        onSurface = Color(p.text),
+        surfaceVariant = Color(p.field),
+        onSurfaceVariant = Color(p.subtext),
+        surfaceTint = Color(p.accent),
+        outline = Color(p.border),
+        outlineVariant = Color(p.border),
+        surfaceBright = Color(p.field),
+        surfaceDim = Color(p.frame),
+        surfaceContainerLowest = Color(p.toolbar),
+        surfaceContainerLow = Color(p.toolbar),
+        surfaceContainer = Color(p.toolbar),
+        surfaceContainerHigh = Color(p.field),
+        surfaceContainerHighest = Color(p.field),
+    )
+
+    /** Recolors the older XML screens of [activity]. Call after the activity theme is set. */
+    fun applyOverlay(activity: Activity) {
+        current(activity)?.let { activity.theme.applyStyle(it.overlay, true) }
+    }
+
+    internal fun save(context: Context, name: String) {
+        PreferenceManager.getDefaultSharedPreferences(context.applicationContext)
+            .edit().putString(THEME_PREF, name).apply()
+        val light = obscurantPalettes.firstOrNull { it.name == name }?.isLight ?: false
+        val settings = context.components.settings
+        settings.shouldFollowDeviceTheme = false
+        settings.shouldUseLightTheme = light
+        settings.shouldUseDarkTheme = !light
+        AppCompatDelegate.setDefaultNightMode(
+            if (light) AppCompatDelegate.MODE_NIGHT_NO else AppCompatDelegate.MODE_NIGHT_YES,
+        )
+    }
+
+    private fun select(activity: Activity, name: String) {
+        save(activity, name)
+        activity.recreate()
+    }
+
+    /** Shows the list of themes with a color sample next to each. */
+    fun showChooser(activity: Activity) {
+        val names = listOf(OBSCURANT_DEFAULT_THEME) + obscurantPalettes.map { it.name }
+        val selected = savedName(activity)
+        val density = activity.resources.displayMetrics.density
+        val size = (SWATCH_DP * density).toInt()
+        val adapter = object : ArrayAdapter<String>(activity, android.R.layout.simple_list_item_1, names) {
+            override fun getView(position: Int, convertView: View?, parent: ViewGroup): View {
+                val view = super.getView(position, convertView, parent) as TextView
+                val palette = obscurantPalettes.firstOrNull { it.name == names[position] }
+                val fill = palette?.toolbar ?: DEFAULT_FILL
+                val ring = palette?.accent ?: DEFAULT_RING
+                val dot = GradientDrawable().apply {
+                    shape = GradientDrawable.OVAL
+                    setColor(fill.toInt())
+                    setStroke((RING_DP * density).toInt(), ring.toInt())
+                    setSize(size, size)
+                }
+                dot.setBounds(0, 0, size, size)
+                view.setCompoundDrawables(dot, null, null, null)
+                view.compoundDrawablePadding = (PAD_DP * density).toInt()
+                view.text = if (names[position] == selected) "${names[position]}  \u2713" else names[position]
+                return view
+            }
+        }
+        AlertDialog.Builder(activity)
+            .setTitle("Obscurant themes")
+            .setAdapter(adapter) { _, which -> select(activity, names[which]) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private const val SWATCH_DP = 24
+    private const val RING_DP = 4
+    private const val PAD_DP = 16
+    private const val DEFAULT_FILL = 0xFF10131A
+    private const val DEFAULT_RING = 0xFF7AA2FF
+}
