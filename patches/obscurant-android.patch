+private const val DONE_PREF = "obscurant_setup_done"
+private const val LEAN_PREF = "obscurant_memory_lean"
+private const val INTRO_MS = 2000
+private const val FADE_MS = 700
+private const val START_SCALE = 0.8f
+
+/** The first launch screen: a short intro, then the choice of look, memory use and default browser. */
+class ObscurantSetupActivity : AppCompatActivity() {
+    private val roleRequest = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) {}
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        setTheme(R.style.NormalTheme)
+        super.onCreate(savedInstanceState)
+        setContent {
+            var theme by rememberSaveable { mutableStateOf(ObscurantThemes.savedName(this)) }
+            val palette = obscurantPalettes.firstOrNull { it.name == theme }
+            val base = if (palette?.isLight == true) acornLightColorScheme() else acornDarkColorScheme()
+            val scheme = palette?.let { ObscurantThemes.apply(base, it) } ?: base
+
+            MaterialTheme(colorScheme = scheme) {
+                Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+                    var introDone by rememberSaveable { mutableStateOf(false) }
+                    if (introDone) {
+                        SetupPage(
+                            theme = theme,
+                            onTheme = { theme = it },
+                            onMakeDefault = ::askToBeDefault,
+                            onStart = { lean -> finishSetup(theme, lean) },
+                        )
+                    } else {
+                        Intro { introDone = true }
+                    }
+                }
+            }
+        }
+    }
+
+    private fun askToBeDefault() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            val roles = getSystemService(RoleManager::class.java)
+            if (roles.isRoleAvailable(RoleManager.ROLE_BROWSER) && !roles.isRoleHeld(RoleManager.ROLE_BROWSER)) {
+                roleRequest.launch(roles.createRequestRoleIntent(RoleManager.ROLE_BROWSER))
+                return
+            }
+        }
+        startActivity(Intent(Settings.ACTION_MANAGE_DEFAULT_APPS_SETTINGS))
+    }
+
+    private fun finishSetup(theme: String, lean: Boolean) {
+        ObscurantThemes.save(this, theme)
+        PreferenceManager.getDefaultSharedPreferences(applicationContext)
+            .edit().putBoolean(DONE_PREF, true).putBoolean(LEAN_PREF, lean).apply()
+        applyMemoryMode(lean)
+        startActivity(
+            Intent(this, HomeActivity::class.java)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK),
+        )
+        finish()
+    }
+
+    @OptIn(ExperimentalAndroidComponentsApi::class)
+    private fun applyMemoryMode(lean: Boolean) {
+        val runtime = components.core.engine as? BrowserPreferencesRuntime ?: return
+        val values = if (lean) LEAN_VALUES else BALANCED_VALUES
+        values.forEach { (name, value) ->
+            runtime.setBrowserPref(name, value, Branch.USER, {}) {
+                Logger("ObscurantSetup").error("could not set $name", it)
+            }
+        }
+    }
+
+    companion object {
+        private val LEAN_VALUES = mapOf(
+            "image.mem.surfacecache.max_size_kb" to 262144,
+            "image.mem.surfacecache.min_expiration_ms" to 15000,
+            "media.memory_caches_combined_limit_kb" to 131072,
+            "browser.cache.memory.capacity" to 32768,
+            "browser.sessionhistory.max_entries" to 20,
+        )
+        private val BALANCED_VALUES = mapOf(
+            "image.mem.surfacecache.max_size_kb" to 1048576,
+            "image.mem.surfacecache.min_expiration_ms" to 60000,
+            "media.memory_caches_combined_limit_kb" to 524288,
+            "browser.cache.memory.capacity" to -1,
+            "browser.sessionhistory.max_entries" to 50,
+        )
+
+        /** True on a normal launch from the app icon until setup has been finished once. */
+        fun shouldShow(context: Context, intent: Intent?): Boolean =
+            intent?.action == Intent.ACTION_MAIN &&
+                !PreferenceManager.getDefaultSharedPreferences(context.applicationContext)
+                    .getBoolean(DONE_PREF, false)
+    }
+}
+
+@Composable
+private fun Intro(onDone: () -> Unit) {
+    val appear = remember { Animatable(0f) }
+    val bar = remember { Animatable(0f) }
+    LaunchedEffect(Unit) {
+        appear.animateTo(1f, tween(FADE_MS))
+        bar.animateTo(1f, tween(INTRO_MS))
+        onDone()
+    }
+    Column(
+        modifier = Modifier.fillMaxSize().clickable(onClick = onDone).padding(32.dp),
+        verticalArrangement = Arrangement.Center,
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Image(
+            painter = painterResource(R.drawable.obscurant_launcher_fg),
+            contentDescription = null,
+            modifier = Modifier.size(200.dp).alpha(appear.value)
+                .scale(START_SCALE + (1f - START_SCALE) * appear.value),
+        )
+        Text(
+            text = "Obscurant",
+            fontSize = 40.sp,
+            fontWeight = FontWeight.Bold,
+            letterSpacing = 3.sp,
+            color = MaterialTheme.colorScheme.onBackground,
+            modifier = Modifier.alpha(appear.value),
+        )
+        Spacer(Modifier.height(24.dp))
+        LinearProgressIndicator(progress = { bar.value }, modifier = Modifier.width(220.dp))
+        Spacer(Modifier.height(24.dp))
+        Text(text = "Private. Light. Yours.", color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+@Composable
+private fun SetupPage(
+    theme: String,
+    onTheme: (String) -> Unit,
+    onMakeDefault: () -> Unit,
+    onStart: (Boolean) -> Unit,
+) {
+    var lean by rememberSaveable { mutableStateOf(true) }
+    val names = remember { listOf(OBSCURANT_DEFAULT_THEME) + obscurantPalettes.map { it.name } }
+
+    Column(modifier = Modifier.fillMaxSize().safeDrawingPadding().padding(20.dp)) {
+        Text(
+            text = "Pick a look",
+            fontSize = 26.sp,
+            fontWeight = FontWeight.Bold,
+            color = MaterialTheme.colorScheme.onBackground,
+        )
+        Spacer(Modifier.height(12.dp))
+        LazyVerticalGrid(
+            columns = GridCells.Fixed(3),
+            modifier = Modifier.fillMaxWidth().weight(1f),
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            items(names) { name -> ThemeTile(name, name == theme) { onTheme(name) } }
+        }
+        Spacer(Modifier.height(16.dp))
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text("Memory", color = MaterialTheme.colorScheme.onBackground, modifier = Modifier.weight(1f))
+            Choice("Balanced", !lean) { lean = false }
+            Spacer(Modifier.width(8.dp))
+            Choice("Lean", lean) { lean = true }
+        }
+        Spacer(Modifier.height(10.dp))
+        OutlinedButton(onClick = onMakeDefault, modifier = Modifier.fillMaxWidth()) {
+            Text("Make Obscurant my browser")
+        }
+        Spacer(Modifier.height(8.dp))
+        Button(onClick = { onStart(lean) }, modifier = Modifier.fillMaxWidth().height(52.dp)) {
+            Text("Start browsing", fontWeight = FontWeight.Bold)
+        }
+        Text(
+            text = "Everything here can be changed later in Settings.",
+            fontSize = 12.sp,
+            textAlign = TextAlign.Center,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+        )
+    }
+}
