+const NAV = [
+  ["general", "General"],
+  ["appearance", "Appearance"],
+  ["search", "Search"],
+  ["privacy", "Privacy and security"],
+  ["proxy", "Proxy and IP"],
+  ["passwords", "Passwords"],
+  ["downloads", "Downloads"],
+  ["permissions", "Site permissions"],
