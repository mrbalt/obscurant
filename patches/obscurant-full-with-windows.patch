+/* Per-site permission view: every site that has been given (or refused) an
+ * ability, with a revoke button. Reads the browser's own permission store. */
+const PERM_NAMES = {
+  "desktop-notification": "Notifications",
+  camera: "Camera",
+  microphone: "Microphone",
+  geo: "Location",
+  popup: "Pop-ups",
+  "persistent-storage": "Persistent storage",
+  "autoplay-media": "Autoplay",
+  midi: "MIDI devices",
+  "midi-sysex": "MIDI devices (full)",
+  xr: "Virtual reality",
+  "screen-wake-lock": "Keep screen awake",
+  "storage-access": "Cross-site cookies",
+  "3rdPartyStorage": "Cross-site cookies",
+  "3rdPartyFrameStorage": "Cross-site cookies",
+  install: "Install add-ons",
+  cookie: "Cookies",
+  "open-protocol-handler": "Open links in apps",
+  "local-network": "Local network",
+  "local-device": "Local devices",
+};
+const PERM_STATES = { 1: "Allowed", 2: "Blocked", 3: "Ask" };
+
+function readSitePermissions() {
+  const sites = new Map();
+  for (const perm of Services.perms.all) {
+    const label = PERM_NAMES[perm.type.split("^")[0]] ?? null;
+    const principal = perm.principal;
+    if (!label || !principal.schemeIs("http") && !principal.schemeIs("https")) {
+      continue;
+    }
+    if (!sites.has(principal.origin)) {
+      sites.set(principal.origin, { principal, items: [] });
+    }
+    sites.get(principal.origin).items.push({
+      type: perm.type,
+      label,
+      state: PERM_STATES[perm.capability] ?? "Other",
+      session: perm.expireType == Services.perms.EXPIRE_SESSION,
+    });
+  }
+  return [...sites.entries()].sort((a, b) => a[0].localeCompare(b[0]));
+}
+
+function sitePermissionsCard() {
+  const box = el("div", { class: "perm-list" });
+  const search = el("input", {
+    type: "search",
+    placeholder: "Find a site",
+    "aria-label": "Find a site",
+  });
+  const render = () => {
+    const q = search.value.trim().toLowerCase();
+    box.textContent = "";
+    const all = readSitePermissions().filter(([origin]) => origin.toLowerCase().includes(q));
+    if (!all.length) {
+      box.append(el("p", { class: "desc", text: q ? "No site matches." : "No site has special permissions yet." }));
+      return;
+    }
+    for (const [origin, site] of all.slice(0, 200)) {
+      const clear = el("button", { class: "btn", type: "button", text: "Clear all" });
+      clear.addEventListener("click", () => {
+        for (const item of site.items) {
+          Services.perms.removeFromPrincipal(site.principal, item.type);
+        }
+        toast("Cleared");
+        render();
+      });
+      const head = el("div", { class: "perm-head" }, el("strong", { text: origin.replace(/^https?:\/\//, "") }), clear);
+      const list = el("div", { class: "perm-items" });
+      for (const item of site.items) {
+        const kind = item.state == "Blocked" ? "warn" : item.state == "Allowed" ? "good" : "";
+        const revoke = el("button", { class: "btn", type: "button", text: "Revoke", title: `Forget ${item.label} for this site` });
+        revoke.addEventListener("click", () => {
+          Services.perms.removeFromPrincipal(site.principal, item.type);
+          render();
+        });
+        list.append(
+          el(
+            "div",
+            { class: "perm-item" },
+            el("span", { text: item.label }),
+            el("span", { class: `pill ${kind}`, text: item.state + (item.session ? " (this session)" : "") }),
+            revoke
+          )
+        );
+      }
+      box.append(el("div", { class: "perm-site" }, head, list));
+    }
+    if (all.length > 200) {
+      box.append(el("p", { class: "desc", text: `Showing 200 of ${all.length}. Use the search box.` }));
+    }
+  };
+  search.addEventListener("input", render);
+  render();
+  return card(
+    row("Sites with permissions", "Everything a website has been allowed or refused. Revoke to make it ask again.", search, "site permissions revoke camera microphone location notifications"),
+    box
+  );
+}
