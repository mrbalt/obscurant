+function el(tag, props = {}, ...kids) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === "class") {
+      node.className = v;
+    } else if (k === "text") {
+      node.textContent = v;
+    } else if (k.startsWith("on")) {
+      node.addEventListener(k.slice(2), v);
+    } else {
+      node.setAttribute(k, v);
+    }
+  }
+  for (const kid of kids) {
+    node.append(kid);
+  }
+  return node;
+}
