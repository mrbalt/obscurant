+  let saved = null;
+  const tick = () => {
+    try {
+      step();
+    } catch (ex) {
+      // A page that changed its layout must not break the browser.
+    }
+  };
+  const step = () => {
+    const wall = doc.querySelector("ytd-enforcement-message-view-model");
+    if (wall) {
+      wall.closest("tp-yt-paper-dialog, ytd-popup-container")?.remove();
+      wall.remove();
+      doc.querySelector("tp-yt-iron-overlay-backdrop")?.remove();
+      doc.querySelector("video")?.play?.();
+    }
+    skipAdShort();
+    const player = doc.querySelector(".html5-video-player");
+    if (!player) {
+      return;
+    }
+    const video = player.querySelector("video");
+    const ad =
+      player.classList.contains("ad-showing") ||
+      player.classList.contains("ad-interrupting");
+    if (!ad) {
+      if (saved && video) {
+        video.playbackRate = saved.rate;
+        video.muted = saved.muted;
+      }
+      saved = null;
+      return;
+    }
+    doc.querySelector(SKIP)?.click();
+    doc.querySelector(".ytp-ad-overlay-close-button")?.click();
+    if (!video) {
+      return;
+    }
+    if (!saved) {
+      saved = { rate: video.playbackRate, muted: video.muted };
+    }
+    video.muted = true;
+    video.playbackRate = 16;
+    if (Number.isFinite(video.duration) && video.duration > 0) {
+      video.currentTime = video.duration;
+    }
+  };
+  const id = win.setInterval(tick, 300);
+  win.addEventListener("pagehide", () => win.clearInterval(id), { once: true });
+}
+
+export const YouTube = {
+  isYouTube,
+  startYouTubeAdBlock,
+  injectPageScript,
+  disablePageScript,
+};
