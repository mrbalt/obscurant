+  play() {
+    if (!Services.prefs.getBoolPref("obscurant.splash.enabled", true)) {
+      return;
+    }
+    // Only the first window of a browser start, and not private/popup windows.
+    if (
+      PrivateBrowsingUtils.isWindowPrivate(window) ||
+      !window.toolbar.visible
+    ) {
+      return;
+    }
+    let count = 0;
+    for (let w of Services.wm.getEnumerator("navigator:browser")) {
+      count++;
+    }
+    let started = Services.startup.getStartupInfo().process;
