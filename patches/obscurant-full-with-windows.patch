+/* Developer tool: about:preferences?memreport&delay=SECONDS&out=/file.json&quit=1
+   saves memory use per process and category, then optionally quits. */
+function runMemReport() {
+  const params = new URLSearchParams(location.search);
+  const delayMs = (parseInt(params.get("delay"), 10) || 0) * 1000;
+  const mgr = Cc["@mozilla.org/memory-reporter-manager;1"].getService(
+    Ci.nsIMemoryReporterManager
+  );
+  const finish = (rows, suffix = "") => {
+    const procs = {};
+    for (const r of rows) {
+      const key = r.process || "Main Process";
+      const p = (procs[key] ||= { label: key.replace(/\(pid \d+\)/, "").trim(), unique: 0, explicit: 0, cats: {} });
+      if (r.path === "resident-unique") {
+        p.unique = r.amount;
+      } else if (r.path.startsWith("explicit/") && r.units === Ci.nsIMemoryReporter.UNITS_BYTES) {
+        const cat = r.path.split("/").slice(0, 4).join("/").replace(/\(.*$/, "");
+        p.cats[cat] = (p.cats[cat] || 0) + r.amount;
+        p.explicit += r.amount;
+      }
+    }
+    const out = Object.values(procs).map(p => ({
+      label: p.label,
+      uniqueMB: Math.round(p.unique / 1048576),
+      explicitMB: Math.round(p.explicit / 1048576),
+      top: Object.entries(p.cats)
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, 24)
+        .map(([k, v]) => [k, Math.round(v / 1048576)]),
+    }));
+    const done = () => {
+      if (params.get("quit")) {
+        Services.startup.quit(Ci.nsIAppStartup.eForceQuit);
+      }
+    };
+    let path = params.get("out");
+    if (path && !PathUtils.normalize(path).startsWith(PathUtils.profileDir + "/")) {
+      path = null;
+    }
+    const target = suffix => (path ? path + suffix : null);
+    const final = !params.get("squeeze") || suffix === ".after";
+    const write = target(suffix);
+    const next = final ? done : () => {};
+    if (write) {
+      IOUtils.writeUTF8(write, JSON.stringify(out)).then(next, next);
+    } else {
+      next();
+    }
+  };
+  const collect = suffix => {
+    const rows = [];
+    mgr.getReports(
+      { callback: (process, path, kind, units, amount) => rows.push({ process, path, units, amount }) },
+      null,
+      { callback: () => finish(rows, suffix) },
+      null,
+      false
+    );
+  };
+  setTimeout(() => {
+    collect(params.get("squeeze") ? ".before" : "");
+    if (params.get("squeeze")) {
+      setTimeout(() => {
+        mgr.minimizeMemoryUsage(() => setTimeout(() => collect(".after"), 2000));
+      }, 3000);
+    }
+  }, delayMs);
+}
+
+if (
+  new URLSearchParams(location.search).has("memreport") &&
+  Services.prefs.getBoolPref("obscurant.dev.memreport", false)
+) {
+  runMemReport();
+}
