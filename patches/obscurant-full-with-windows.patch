+const HASH_ALIASES = {
+  home: "general",
+  sync: "general",
+  containers: "privacy",
+  experimental: "general",
+  paneGeneral: "general",
+  panePrivacy: "privacy",
+  paneSearch: "search",
+  paneHome: "general",
