+function virusTotalKeyRow() {
+  const { apiKeyPath } = ChromeUtils.importESModule("resource://gre/modules/DownloadVirusTotal.sys.mjs");
+  const file = apiKeyPath();
+  const dir = PathUtils.parent(file);
+  const pill = el("span", { class: "pill", text: "Checking" });
+  const input = el("input", {
+    type: "password",
+    placeholder: "Paste your key (64 letters and numbers)",
+    autocomplete: "off",
+    spellcheck: "false",
+  });
+  const save = el("button", { class: "btn primary", type: "button", text: "Save and test" });
+  const remove = el("button", { class: "btn", type: "button", text: "Remove" });
+  const msg = el("div", { class: "desc vt-msg" });
+
+  const show = (text, cls) => {
+    pill.textContent = text;
+    pill.className = `pill ${cls}`;
+  };
+  const refresh = async () => {
+    const found = await IOUtils.exists(file);
+    show(found ? "Key saved" : "No key", found ? "good" : "warn");
+    remove.hidden = !found;
+  };
+  refresh();
+
+  save.addEventListener("click", async () => {
+    const key = input.value.trim();
+    if (!/^[0-9a-f]{64}$/i.test(key)) {
+      msg.textContent = "That does not look like a VirusTotal key. It is 64 letters and numbers, with no spaces.";
+      return;
+    }
+    save.disabled = true;
+    msg.textContent = "Testing the key with VirusTotal...";
+    try {
+      const { testApiKey } = ChromeUtils.importESModule("resource://gre/modules/DownloadVirusTotal.sys.mjs");
+      const result = await testApiKey(key);
+      if (result === "rejected") {
+        msg.textContent = "VirusTotal rejected this key. Check that you copied all of it.";
+        return;
+      }
+      if (result === "offline") {
+        msg.textContent = "Could not reach VirusTotal. Check your internet connection. Nothing was saved.";
+        return;
+      }
+      if (result === "error") {
+        msg.textContent = "VirusTotal answered with an error. Not saved. Try again in a minute.";
+        return;
+      }
+      msg.textContent =
+        result === "limit"
+          ? "The key works but is out of lookups for now. Saved anyway."
+          : "The key works and is saved. New downloads are now checked.";
+      await IOUtils.makeDirectory(dir, { createAncestors: true, ignoreExisting: true });
+      await IOUtils.writeUTF8(file, key, { mode: 0o600 });
+      input.value = "";
+      await refresh();
+    } catch (ex) {
+      msg.textContent = "Could not reach VirusTotal. Check your internet connection. Nothing was saved.";
+    } finally {
+      save.disabled = false;
+    }
+  });
+  remove.addEventListener("click", async () => {
+    await IOUtils.remove(file, { ignoreAbsent: true });
+    msg.textContent = "Key removed. Downloads are no longer checked.";
+    await refresh();
+  });
+
+  const steps = [
+    "Go to virustotal.com and click Sign up. You only need an email address and a password.",
+    "Open the confirmation email from VirusTotal and click the link in it.",
+    "Sign in, click your profile picture in the top right, then click API key.",
+    "Click the copy button next to the long key. It is 64 letters and numbers.",
+    "Paste it into the box above and press Save and test.",
+  ];
+  const help = el(
+    "details",
+    { class: "vt-help" },
+    el("summary", { text: "How do I get a free key?" }),
+    el("ol", {}, ...steps.map(t => el("li", { text: t }))),
+    el("p", {
+      class: "desc",
+      text: "The free key allows about 4 lookups a minute, which is plenty for downloads. Only the fingerprint of a file is sent, never the file, unless you press Scan with VirusTotal yourself. The key is kept in a file only you can read.",
+    })
+  );
+  const link = el("a", { href: "https://www.virustotal.com/gui/join-us", target: "_blank", text: "Open the VirusTotal sign-up page" });
+  help.append(link);
+
+  const r = row(
+    "VirusTotal key",
+    `Without a key, downloads are not checked. The key is saved in ${file}.`,
+    el("div", { class: "vt-key" }, pill, input, save, remove),
+    "virustotal api key scan download check tutorial"
+  );
+  r.querySelector(".text").append(msg, help);
+  return r;
+}
