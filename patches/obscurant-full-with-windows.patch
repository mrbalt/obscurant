+    presetsTried.ramActive = btn("Max RAM savings").getAttribute("aria-checked");
+    btn("Max privacy").click();
+    presetsTried.afterPrivacy_unload = unload();
+    presetsTried.rfp = Services.prefs.getBoolPref("privacy.resistFingerprinting");
+    btn("Default").click();
+    presetsTried.afterDefault = unload();
+    presetsTried.rfpAfterDefault = Services.prefs.getBoolPref("privacy.resistFingerprinting");
+    presetsTried.defaultActive = btn("Default").getAttribute("aria-checked");
+    const perms = {};
+    try {
+      for (const [u, t, c] of [
+        ["https://example.com", "camera", 1],
+        ["https://example.com", "geo", 2],
+        ["https://example.org", "desktop-notification", 1],
+      ]) {
+        Services.perms.addFromPrincipal(Services.scriptSecurityManager.createContentPrincipalFromOrigin(u), t, c);
+      }
+      const box = contentEl.querySelector(".perm-list");
+      const search = box.parentElement.querySelector("input[type=search]");
+      search.dispatchEvent(new Event("input"));
+      perms.sites = box.querySelectorAll(".perm-site").length;
+      perms.items = box.querySelectorAll(".perm-item").length;
+      box.querySelector(".perm-item .btn").click();
+      perms.itemsAfterRevoke = box.querySelectorAll(".perm-item").length;
+      box.querySelector(".perm-head .btn").click();
+      perms.sitesAfterClear = box.querySelectorAll(".perm-site").length;
+      search.value = "zzz-none";
+      search.dispatchEvent(new Event("input"));
+      perms.emptyText = box.textContent;
+    } catch (ex) {
+      perms.error = String(ex);
+    }
+    await IOUtils.writeUTF8(
+      PathUtils.join(PathUtils.profileDir, "obscurant-settings-selftest.json"),
+      JSON.stringify({
+        presetsTried,
+        perms,
+        hash: location.hash,
+        cards: contentEl.querySelectorAll(".card").length,
+        presetButtons: [...contentEl.querySelectorAll(".seg button")].filter(b => /Max|Default/.test(b.textContent)).map(b => b.textContent),
+        rows: contentEl.querySelectorAll(".row").length,
+      })
+    );
+    Services.startup.quit(Ci.nsIAppStartup.eForceQuit);
+  }, 4000);
+}
