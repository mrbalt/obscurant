+  const m = b.length;
+  if (!n || !m) {
+    return 0;
+  }
+  let prev = Array.from({ length: m + 1 }, (_, i) => i);
+  for (let i = 1; i <= n; i++) {
+    const row = [i];
+    for (let j = 1; j <= m; j++) {
