+
+/*
+ * Looks up a finished download's SHA-256 on VirusTotal. Only the hash is sent,
+ * never the file. Fails open: any error, a missing key, or an unknown hash
+ * lets the download through, but the result says which of these happened
+ * (status) so the Downloads panel can tell the user the file was not checked.
+ */
+
+import {
+  clearTimeout,
+  setTimeout,
+} from "resource://gre/modules/Timer.sys.mjs";
+
+const API_BASE_DEFAULT = "https://www.virustotal.com/api/v3/";
+const apiBase = () =>
+  Services.prefs.getStringPref("obscurant.virustotal.api_base", API_BASE_DEFAULT);
+const MAX_UPLOAD_BYTES = 32 * 1024 * 1024;
+const MIN_REQUEST_GAP_MS = 16000;
+const REQUEST_TIMEOUT_MS = 12000;
+
+const SAFE = {
+  shouldBlock: false,
+  verdict: Ci.nsIApplicationReputationService.VERDICT_SAFE,
+};
+
+const QUOTA_PAUSE_MS = 60 * 60 * 1000;
+
+const unchecked = reason => ({ ...SAFE, status: `unchecked: ${reason}` });
+
+let lastRequestTime = 0;
+let pausedUntil = 0;
+let queue = Promise.resolve();
+
+function toHex(hash) {
+  if (/^[0-9a-f]{64}$/i.test(hash)) {
+    return hash.toLowerCase();
+  }
+  return Array.from(hash, c => c.charCodeAt(0).toString(16).padStart(2, "0"))
+    .join("");
+}
+
+export function apiKeyPath() {
+  const custom = Services.prefs.getStringPref("downloads.virustotal.key_path", "");
+  if (custom) {
+    return custom;
+  }
+  if (Services.appinfo.OS === "WINNT") {
+    return PathUtils.join(Services.dirsvc.get("AppData", Ci.nsIFile).path, "Obscurant", "vt-api-key");
+  }
+  return PathUtils.join(Services.dirsvc.get("Home", Ci.nsIFile).path, ".config", "browser", "vt-api-key");
+}
+
+async function readApiKey() {
+  const path = apiKeyPath();
+  try {
+    const key = (await IOUtils.readUTF8(path)).trim();
+    // A VirusTotal key is 64 hex characters. Anything else is never sent.
+    return /^[0-9a-f]{64}$/i.test(key) ? key : "";
+  } catch (ex) {
+    return "";
+  }
+}
+
+async function lookup(hex, key) {
+  let wait = lastRequestTime + MIN_REQUEST_GAP_MS - Date.now();
+  if (wait > 0) {
+    await new Promise(resolve => setTimeout(resolve, wait));
+  }
+  lastRequestTime = Date.now();
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
+  try {
+    return await fetch(apiBase() + "files/" + hex, {
+      headers: { "x-apikey": key },
+      credentials: "omit",
+      cache: "no-store",
+      referrerPolicy: "no-referrer",
+      signal: controller.signal,
+    });
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function debug(msg) {
+  if (Services.prefs.getBoolPref("obscurant.virustotal.debug", false)) {
+    dump(`[VirusTotal] ${msg}\n`);
+  }
+}
+
+const DOC_TYPES = new Set([
+  "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "rtf", "odt",
+  "jpg", "jpeg", "png", "gif", "webp", "mp3", "mp4", "mkv", "avi", "mov",
+]);
+const RUNNABLE = "exe|scr|bat|cmd|com|msi|js|jse|vbs|vbe|wsf|jar|sh|appimage|desktop|lnk|ps1";
+const DOUBLE_EXT = new RegExp(
+  `\\.(${[...DOC_TYPES].join("|")}|zip|rar|7z)[ _]*\\.(${RUNNABLE})$`,
+  "i"
+);
+
+// Cheap local check, no network: a file named like a document that is really a
+// program, or a name that hides its real ending. Returns a reason or "".
+export async function disguisedFileReason(path, partPath = null) {
+  const name = PathUtils.filename(path);
+  if (/[\u202a-\u202e\u2066-\u2069]/.test(name)) {
+    return "the name contains a hidden text-direction character";
+  }
+  if (DOUBLE_EXT.test(name)) {
+    return "it is named like a document but ends like a program";
+  }
+  const ext = (name.match(/\.([a-z0-9]+)$/i)?.[1] || "").toLowerCase();
+  if (DOC_TYPES.has(ext)) {
+    try {
+      let head;
+      for (const candidate of [partPath, path]) {
+        if (candidate && (await IOUtils.exists(candidate))) {
+          head = await IOUtils.read(candidate, { maxBytes: 4 });
+          break;
+        }
+      }
+      if (!head) {
+        return "";
+      }
+      const s = String.fromCharCode(...head);
+      if (s.startsWith("MZ") || s.startsWith("\x7fELF") || s.startsWith("#!")) {
+        return "it is named like a document but is really a program";
+      }
+    } catch (ex) {
+      // Unreadable: leave it to the other checks.
+    }
+  }
+  return "";
+}
+
+// Only ever called after the user says yes: this sends the whole file.
+export async function testApiKey(key) {
+  if (!/^[0-9a-f]{64}$/i.test(key)) {
+    return "malformed";
+  }
+  try {
+    const res = await lookup(
+      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+      key
+    );
+    if (res.status === 401 || res.status === 403) {
+      return "rejected";
+    }
+    if (res.status === 429) {
+      return "limit";
+    }
+    return res.ok || res.status === 404 ? "ok" : "error";
+  } catch (ex) {
+    return "offline";
+  }
+}
+
+export async function uploadAndScan(download) {
+  const key = await readApiKey();
+  if (!key) {
+    throw new Error("no valid VirusTotal key");
+  }
+  const path = download.target.path;
+  const bytes = await IOUtils.read(path);
+  if (bytes.length > MAX_UPLOAD_BYTES) {
+    throw new Error("the file is over 32 MB, too big for this upload");
+  }
+  const form = new FormData();
+  form.append("file", new Blob([bytes]), PathUtils.filename(path));
+  const common = { credentials: "omit", cache: "no-store", referrerPolicy: "no-referrer" };
+  const up = await fetch(apiBase() + "files", {
+    ...common,
+    method: "POST",
+    headers: { "x-apikey": key },
+    body: form,
+  });
+  if (!up.ok) {
+    throw new Error(`upload failed (HTTP ${up.status})`);
+  }
+  const id = (await up.json()).data.id;
+  const gap = Services.prefs.getIntPref("obscurant.virustotal.poll_ms", 15000);
+  for (let i = 0; i < 24; i++) {
+    await new Promise(resolve => setTimeout(resolve, gap));
+    const res = await fetch(apiBase() + "analyses/" + id, {
+      ...common,
+      headers: { "x-apikey": key },
+    });
+    if (!res.ok) {
+      continue;
+    }
+    const attrs = (await res.json()).data.attributes;
+    if (attrs.status === "completed") {
+      const stats = attrs.stats || {};
+      let hash = "";
+      try {
+        hash = toHex(download.saver.getSha256Hash());
+      } catch (ex) {
+        // No hash: the report link is simply not offered.
+      }
+      return { malicious: stats.malicious ?? 0, suspicious: stats.suspicious ?? 0, hash };
+    }
+  }
+  throw new Error("VirusTotal did not finish in time; try again later");
+}
+
+export var DownloadVirusTotal = {
+  /**
+   * @param {string} aSha256Hash Hash from the download saver (raw bytes or hex).
+   * @returns {Promise<{shouldBlock: boolean, verdict: number}>}
+   */
+  check(aSha256Hash) {
+    let result = queue.then(() => this._check(aSha256Hash));
+    queue = result.catch(() => {});
+    return result;
+  },
+
+  async _check(aSha256Hash) {
+    try {
+      let key = await readApiKey();
+      debug(`check start: key=${key ? "found" : "MISSING"} hash=${aSha256Hash ? toHex(aSha256Hash) : "NONE"}`);
+      if (!key) {
+        return unchecked("no VirusTotal key yet. Add one in Settings > Downloads > VirusTotal key");
+      }
+      if (!aSha256Hash) {
+        return unchecked("no hash");
+      }
+      if (Date.now() < pausedUntil) {
+        return unchecked("daily quota used up");
+      }
+      let response = await lookup(toHex(aSha256Hash), key);
+      debug(`response status ${response.status}`);
+      if (response.status == 404) {
+        return { ...SAFE, status: "unknown to VirusTotal" };
+      }
+      if (response.status == 429) {
+        pausedUntil = Date.now() + QUOTA_PAUSE_MS;
+        return unchecked("quota used up");
+      }
+      if (!response.ok) {
+        console.warn(`VirusTotal lookup failed: HTTP ${response.status}`);
+        return unchecked(`VirusTotal error ${response.status}`);
+      }
+      let stats = (await response.json()).data.attributes.last_analysis_stats;
+      let malicious = stats.malicious ?? 0;
+      let suspicious = stats.suspicious ?? 0;
+      debug(`stats malicious=${malicious} suspicious=${suspicious}`);
+      let found = {
+        vtHash: toHex(aSha256Hash),
+        malicious,
+        suspicious,
+      };
+      let blockMin = Services.prefs.getIntPref(
+        "downloads.virustotal.block_min_malicious",
+        3
+      );
+      if (malicious >= blockMin) {
+        return {
+          ...found,
+          shouldBlock: true,
+          verdict: Ci.nsIApplicationReputationService.VERDICT_DANGEROUS,
+        };
+      }
+      if (malicious > 0 || suspicious > 0) {
+        return {
+          ...found,
+          shouldBlock: true,
+          verdict:
+            Ci.nsIApplicationReputationService.VERDICT_POTENTIALLY_UNWANTED,
+        };
+      }
+      return { ...found, ...SAFE, status: "clean" };
+    } catch (ex) {
+      console.warn("VirusTotal lookup error:", ex);
+      debug(`error: ${ex}`);
+      return unchecked("lookup failed");
+    }
+  },
+};
