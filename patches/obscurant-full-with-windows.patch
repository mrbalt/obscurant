+
+  _actor(win) {
+    try {
+      return win.gBrowser.selectedBrowser.browsingContext.currentWindowGlobal.getActor("ObscurantCosmetic");
+    } catch (ex) {
+      return null;
+    }
+  },
+
+  async _search(win, query) {
+    try {
+      await lazy.SearchService.init();
+      const engine = await lazy.SearchService.getDefault();
+      const sub = engine?.getSubmission(query);
+      if (sub) {
+        win.openTrustedLinkIn(sub.uri.spec, "current");
+        return;
+      }
+    } catch (ex) {
+      this.lastError = String(ex?.message || ex);
