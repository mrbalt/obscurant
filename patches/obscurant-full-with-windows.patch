+/* Proxy */
+
+const PROXY_KEYS = {
+  host: "obscurant.proxy.host",
+  port: "obscurant.proxy.port",
+};
+
+function torBusy() {
+  const { ObscurantProxy } = ChromeUtils.importESModule(
+    "resource:///modules/ObscurantProxy.sys.mjs"
+  );
+  return ObscurantProxy.state === "on" || ObscurantProxy.state === "starting";
+}
+
+// The manual switch describes only the manual proxy. Tor owns the proxy
+// settings while it is running, so this switch must never undo them.
+function proxyIsOn() {
+  return (
+    !torBusy() &&
+    readPref("network.proxy.type", 0) === 1 &&
+    readPref("network.proxy.socks", "") !== ""
+  );
+}
+
+function applyProxy(on) {
+  if (torBusy()) {
+    toast("Disconnect Tor first. It controls the proxy while it is on.");
+    return false;
+  }
+  if (on) {
+    const host = readPref(PROXY_KEYS.host, "").trim();
+    const port = parseInt(readPref(PROXY_KEYS.port, 0), 10);
+    if (!host || !port) {
+      return false;
+    }
+    PREFS.setStringPref("network.proxy.socks", host);
+    PREFS.setIntPref("network.proxy.socks_port", port);
+    PREFS.setIntPref("network.proxy.socks_version", 5);
+    PREFS.setBoolPref("network.proxy.socks_remote_dns", true);
+    PREFS.setBoolPref("network.proxy.socks5_remote_dns", true);
+    PREFS.setBoolPref("network.proxy.failover_direct", false);
+    PREFS.setBoolPref("network.proxy.allow_bypass", false);
+    PREFS.setStringPref("network.proxy.no_proxies_on", "localhost, 127.0.0.1, ::1");
+    PREFS.setBoolPref("media.peerconnection.ice.proxy_only", true);
+    PREFS.setIntPref("network.proxy.type", 1);
+  } else {
+    PREFS.setIntPref("network.proxy.type", 0);
+    PREFS.setBoolPref("media.peerconnection.ice.proxy_only", false);
+  }
+  return true;
+}
+
+
+function torRow() {
+  const { ObscurantProxy } = ChromeUtils.importESModule(
+    "resource:///modules/ObscurantProxy.sys.mjs"
+  );
+  const pill = el("span", { class: "pill" });
+  const btn = el("button", { class: "btn primary", type: "button" });
+  const desc = el("div", { class: "desc" });
+  let installed = true;
+
+  const paint = () => {
+    const st = ObscurantProxy.state;
+    const busy = st === "starting";
+    const on = st === "on";
+    btn.textContent = on || busy ? "Disconnect" : "Connect";
+    btn.disabled = !installed && !on && !busy;
+    if (!installed && !on && !busy) {
+      pill.textContent = "Tor not installed";
+      pill.className = "pill warn";
+      desc.textContent =
+        Services.appinfo.OS === "WINNT"
+          ? "The Tor program is missing. Reinstall Obscurant, or put tor.exe in the tor folder next to obscurant.exe."
+          : "Install the tor package once (on Arch: sudo pacman -S tor). Then this button starts it for you.";
+    } else if (on) {
+      pill.textContent = "Connected";
+      pill.className = "pill good";
+      desc.textContent =
+        "Sites see a Tor exit address. Expect slower pages and some captchas.";
+    } else if (busy) {
+      pill.textContent = `${ObscurantProxy.progress}%`;
+      pill.className = "pill";
+      desc.textContent = ObscurantProxy.message;
+    } else if (st === "error") {
+      pill.textContent = "Not connected";
+      pill.className = "pill warn";
+      desc.textContent = ObscurantProxy.message;
+    } else {
+      pill.textContent = "Off";
+      pill.className = "pill";
+      desc.textContent =
+        "Hides your IP address using the Tor network. One click, no account.";
+    }
+  };
+
+  btn.addEventListener("click", async () => {
+    const st = ObscurantProxy.state;
+    if (st === "on" || st === "starting") {
+      await ObscurantProxy.stop();
+    } else {
+      ObscurantProxy.startTor().catch(() => paint());
+    }
+    paint();
+  });
+
+  ObscurantProxy.addListener(paint);
+  window.addEventListener("pagehide", () => ObscurantProxy.removeListener(paint));
+  ObscurantProxy.torInstalled().then(found => {
+    installed = found;
+    paint();
+  });
+  paint();
+
+  const text = el("div", { class: "text" }, el("div", { class: "label", text: "Hide my IP with Tor" }), desc);
+  const r = el("div", { class: "row" }, text, el("div", { class: "ctl" }, pill, btn));
+  r.dataset.search = "tor hide ip address anonymous onion proxy one click";
+  return r;
+}
+
+function proxyCard() {
+  const c = card();
+  c.dataset.search =
+    "proxy ip mask hide vpn tor socks mullvad privacy address";
+
+  c.append(torRow());
+
+  const pill = el("span", { class: "pill" });
+  const sw = el("button", { class: "switch", type: "button", role: "switch" });
+  const syncState = () => {
+    const on = proxyIsOn();
+    sw.setAttribute("aria-checked", String(on));
+    pill.textContent = on
+      ? `On: ${readPref("network.proxy.socks", "")}:${readPref("network.proxy.socks_port", 0)}`
+      : "Off";
+    pill.className = on ? "pill good" : "pill";
+  };
+  sw.addEventListener("click", () => {
+    const turningOn = !proxyIsOn();
+    if (!applyProxy(turningOn)) {
+      toast("Enter a proxy address and port first");
+      return;
+    }
+    syncState();
+    toast(turningOn ? "Proxy on" : "Proxy off");
+  });
+  c.append(
+    row(
+      "Route traffic through a proxy",
+      "Sites see the proxy's address instead of yours. Web address lookups go through it too.",
+      el("span", { class: "ctl" }, pill, sw)
+    )
+  );
+
+  const host = el("input", { type: "text", placeholder: "127.0.0.1" });
+  const port = el("input", { type: "number", min: "1", max: "65535", placeholder: "9050" });
+  host.value = readPref(PROXY_KEYS.host, "");
+  port.value = readPref(PROXY_KEYS.port, "") || "";
+  const save = () => {
+    PREFS.setStringPref(PROXY_KEYS.host, host.value.trim());
+    PREFS.setIntPref(PROXY_KEYS.port, parseInt(port.value, 10) || 0);
+    if (proxyIsOn()) {
+      applyProxy(true);
+      syncState();
+    }
+  };
+  host.addEventListener("change", save);
+  port.addEventListener("change", save);
+  c.append(row("Proxy address (SOCKS5)", "", host), row("Port", "", port));
+
+  const presets = el("span", { class: "ctl" });
+  for (const [label, h, p] of [
+    Services.appinfo.OS === "WINNT" ? ["Tor Browser", "127.0.0.1", 9150] : ["Tor", "127.0.0.1", 9050],
+    ["Mullvad VPN", "10.64.0.1", 1080],
+  ]) {
+    const b = el("button", { class: "btn", type: "button", text: label });
+    b.addEventListener("click", () => {
+      host.value = h;
+      port.value = String(p);
+      save();
+      toast(`${label} address filled in`);
+    });
+    presets.append(b);
+  }
+  c.append(
+    row(
+      "Quick fill",
+      Services.appinfo.OS === "WINNT"
+        ? "Tor Browser must be open for its address to work. Mullvad's address only works while connected to their VPN."
+        : "Tor needs its program running on this computer. Mullvad's address only works while connected to their VPN.",
+      presets
+    )
+  );
+
+  const ipPill = el("span", { class: "pill", text: "Not checked" });
+  const check = el("button", { class: "btn", type: "button", text: "Show my current address" });
+  check.addEventListener("click", async () => {
+    ipPill.textContent = "Checking...";
+    try {
+      const response = await fetch("https://api.ipify.org?format=text", { cache: "no-store" });
+      ipPill.textContent = (await response.text()).trim();
+      ipPill.className = "pill good";
+    } catch (ex) {
+      ipPill.textContent = "Could not reach the check service";
+      ipPill.className = "pill warn";
+    }
+  });
+  c.append(
+    row(
+      "Check",
+      "Asks api.ipify.org which address it sees. Only runs when you click.",
+      el("span", { class: "ctl" }, ipPill, check)
+    )
+  );
+  c.append(
+    row(
+      "If the proxy stops working",
+      "Pages fail to load. Nothing falls back to your real connection. Video calls use the proxy only, so some may not connect.",
+      el("span", { class: "pill good", text: "No direct fallback" })
+    )
+  );
+
+  syncState();
+  for (const name of ["network.proxy.type", "network.proxy.socks", "network.proxy.socks_port"]) {
+    watch(name, syncState);
+  }
+  return c;
+}
