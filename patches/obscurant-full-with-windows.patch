+    s.setProperty("--panel", theme.toolbar);
+    s.setProperty("--field", theme.field);
+    s.setProperty("--text", theme.text);
+    s.setProperty("--sub", theme.sub);
+    s.setProperty("--accent", theme.accent);
+    s.setProperty("--border", theme.border);
+  }
+  paintPage.exposed = true;
+  window.obscurantPaintTheme = paintPage;
