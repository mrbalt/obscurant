+#[no_mangle]
+pub unsafe extern "C" fn content_classifier_engine_url_cosmetic_resources(
+    engine: *const ContentClassifierFFIEngine,
+    url: &nsACString,
+    out_json: *mut nsCString,
+) -> nsresult {
+    if engine.is_null() || out_json.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+    let engine = &(*engine).engine;
+    let url_str = String::from_utf8_lossy(url.as_ref()).to_string();
+    let resources = engine.url_cosmetic_resources(&url_str);
+
+    let mut json = String::from("{\"hide\":");
+    push_json_array(&mut json, resources.hide_selectors.iter());
+    json.push_str(",\"exceptions\":");
+    push_json_array(&mut json, resources.exceptions.iter());
+    json.push_str(",\"generichide\":");
+    json.push_str(if resources.generichide { "true" } else { "false" });
+    json.push('}');
+    (*out_json).assign(&json);
+    NS_OK
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn content_classifier_engine_hidden_class_id_selectors(
+    engine: *const ContentClassifierFFIEngine,
+    classes: &nsACString,
+    ids: &nsACString,
+    exceptions: &nsACString,
+    out_json: *mut nsCString,
+) -> nsresult {
+    if engine.is_null() || out_json.is_null() {
+        return NS_ERROR_INVALID_ARG;
+    }
+    let engine = &(*engine).engine;
+    let split = |value: &nsACString| -> Vec<String> {
+        String::from_utf8_lossy(value.as_ref())
+            .split('\n')
+            .filter(|part| !part.is_empty())
+            .map(|part| part.to_string())
+            .collect()
+    };
+    let class_list = split(classes);
+    let id_list = split(ids);
+    let exception_set: HashSet<String> = split(exceptions).into_iter().collect();
+
+    let selectors = engine.hidden_class_id_selectors(class_list, id_list, &exception_set);
+    let mut json = String::new();
+    push_json_array(&mut json, selectors.iter());
+    (*out_json).assign(&json);
+    NS_OK
+}
