+// Segments to skip for one video. Only the first 4 hex characters of the video id's
+// hash are sent, with no cookies and no referrer. Null means "none / not allowed".
+async function sponsorSegments(videoId) {
+  if (!/^[\w-]{11}$/.test(videoId || "")) {
+    return null;
+  }
+  const cats = SB_CATS.filter(c =>
+    Services.prefs.getBoolPref(`obscurant.sponsorblock.cat.${c}`, SB_DEFAULT_ON.has(c))
+  );
+  if (!cats.length) {
+    return null;
+  }
+  const prefix = sha256Hex(videoId).slice(0, 4);
+  const key = prefix + "|" + cats.join(",");
+  const hit = sbCache.get(key);
+  let list = hit && Date.now() - hit.at < 3600e3 ? hit.data : null;
+  if (!list) {
+    if (Date.now() - (sbFailedAt.get(prefix) || 0) < 60e3) {
+      return null;
+    }
+    const base = Services.prefs.getStringPref("obscurant.sponsorblock.api", "https://sponsor.ajay.app").replace(/\/+$/, "");
+    const url =
+      `${base}/api/skipSegments/${prefix}?categories=${encodeURIComponent(JSON.stringify(cats))}` +
+      `&actionTypes=${encodeURIComponent('["skip"]')}&service=YouTube`;
+    const ctl = new AbortController();
+    const timer = setTimeout(() => ctl.abort(), 8000);
+    try {
+      const res = await fetch(url, {
+        credentials: "omit",
+        referrerPolicy: "no-referrer",
+        signal: ctl.signal,
+      });
