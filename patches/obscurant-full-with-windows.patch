+function numberRow({ pref, label, desc, min = 0, max = 100 }) {
+  const input = el("input", { type: "number", min: String(min), max: String(max) });
+  input.value = readPref(pref, min);
+  input.addEventListener("change", () => {
+    const n = Math.min(max, Math.max(min, parseInt(input.value, 10) || min));
+    writePref(pref, n);
+    input.value = n;
+    toast("Saved");
+  });
+  return row(label, desc, input);
