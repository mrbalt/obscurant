+  let lastAdSkip = 0;
+  const skipAdShort = () => {
+    if (!win.location.pathname.startsWith("/shorts")) {
+      return;
+    }
+    const active = doc.querySelector("ytd-reel-video-renderer[is-active]");
+    if (!active || Date.now() - lastAdSkip < 1200) {
+      return;
+    }
+    let isAd = !!active.querySelector("ytd-ad-slot-renderer, ytd-in-feed-ad-layout-renderer, [is-ad], .ytReelAdPlayer");
+    if (!isAd) {
+      for (const el of active.querySelectorAll("span, div, a")) {
+        if (el.childElementCount === 0) {
+          const t = (el.textContent || "").trim();
+          if (t === "Sponsored" || t === "Ad") {
+            isAd = true;
+            break;
+          }
+        }
+      }
+    }
+    if (isAd) {
+      lastAdSkip = Date.now();
+      (doc.querySelector("#navigation-button-down button") || doc.querySelector("#navigation-button-down"))?.click();
+    }
+  };
