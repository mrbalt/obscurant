+
+// Obscurant: asks the kernel to move this process's private writable memory
+// (heap, GC chunks, anonymous pages) to swap. Contents are kept and come back
+// on access. Shared and executable mappings are left alone.
+static void PageOutPrivateMemory() {
+  FILE* maps = fopen("/proc/self/maps", "r");
+  if (!maps) {
+    return;
+  }
+  char line[512];
+  while (fgets(line, sizeof(line), maps)) {
+    unsigned long start = 0;
+    unsigned long end = 0;
+    char perms[5] = {0};
+    if (sscanf(line, "%lx-%lx %4s", &start, &end, perms) != 3) {
+      continue;
+    }
+    if (perms[1] != 'w' || perms[2] == 'x' || perms[3] != 'p') {
+      continue;
+    }
+    if (strstr(line, "[stack") || strstr(line, "[vvar") ||
+        strstr(line, "[vsyscall")) {
+      continue;
+    }
+    madvise(reinterpret_cast<void*>(start), end - start, MADV_PAGEOUT);
+  }
+  fclose(maps);
+}
+
+static void SchedulePageOutWhenStillBackground(ContentChild* aChild) {
+  RefPtr<ContentChild> child = aChild;
+  NS_DelayedDispatchToCurrentThread(
+      NS_NewRunnableFunction("ContentChild::PageOutCheck",
+                             [child] {
+                               if (child->GetProcessPriority() ==
+                                   hal::PROCESS_PRIORITY_BACKGROUND) {
+                                 NS_DispatchBackgroundTask(
+                                     NS_NewRunnableFunction(
+                                         "ContentChild::PageOut",
+                                         [] { PageOutPrivateMemory(); }),
+                                     NS_DISPATCH_EVENT_MAY_BLOCK);
+                               }
+                             }),
+      StaticPrefs::dom_memory_obscurant_pageout_delay_ms());
+}
