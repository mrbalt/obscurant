+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  ContentBlockingAllowList:
+    "resource://gre/modules/ContentBlockingAllowList.sys.mjs",
+  PrivateBrowsingUtils: "resource://gre/modules/PrivateBrowsingUtils.sys.mjs",
+});
+
+const BLOCK_PREF = "privacy.trackingprotection.content.protection.enabled";
+const COSMETIC_PREF = "obscurant.cosmetic.enabled";
+
+function parse(list) {
+  const out = [];
+  for (const text of list) {
+    try {
+      out.push(JSON.parse(text));
+    } catch (ex) {
+      // Skip a malformed engine result.
+    }
+  }
+  return out;
+}
+
+const SB_CATS = ["sponsor", "selfpromo", "interaction", "intro", "outro", "preview", "music_offtopic"];
+const SB_DEFAULT_ON = new Set(["sponsor", "selfpromo", "interaction"]);
+const sbCache = new Map(); // "prefix|cats" -> { at, data }
+const sbFailedAt = new Map();
+
+function sha256Hex(text) {
+  const h = Cc["@mozilla.org/security/hash;1"].createInstance(Ci.nsICryptoHash);
+  h.init(h.SHA256);
+  const bytes = new TextEncoder().encode(text);
+  h.update(bytes, bytes.length);
+  return [...h.finish(false)]
+    .map(c => c.charCodeAt(0).toString(16).padStart(2, "0"))
+    .join("");
+}
