+  }
+
+  receiveMessage(message) {
+    if (message.name === "Obscurant:YouTube") {
+      return !!this._allowed();
+    }
+    if (message.name === "Obscurant:SponsorBlock") {
+      const state = this._allowed();
+      if (!state || state.isPrivate || !Services.prefs.getBoolPref("obscurant.sponsorblock.enabled", false)) {
+        return null;
+      }
+      return sponsorSegments(message.data?.id);
+    }
+    if (message.name === "Obscurant:AI") {
+      if (!this._allowed()) {
+        return null;
+      }
+      const p = Services.prefs;
+      const o = {
+        hide: p.getBoolPref("obscurant.ai.hide", false),
+        skip: p.getBoolPref("obscurant.ai.skip", false),
+        images: p.getBoolPref("obscurant.ai.images", false),
+      };
+      return o.hide || o.skip || o.images ? o : null;
+    }
+    if (message.name === "Obscurant:Log") {
+      trace(message.data);
+      return null;
+    }
+    const state = this._allowed();
+    const debug = Services.prefs.getBoolPref("obscurant.cosmetic.debug", false);
+    if (debug) {
+      trace(`${message.name} allowed=${!!state}`);
+    }
+    if (!state) {
+      return null;
+    }
+    const svc = Cc["@mozilla.org/content-classifier-service;1"].getService(
+      Ci.nsIContentClassifierService
+    );
+    if (message.name === "Obscurant:Cosmetic") {
+      const url = this.manager.documentURI?.spec;
+      if (!url || !/^https?:/.test(url)) {
+        return null;
+      }
+      const raw = svc.getCosmeticResources(url, state.isPrivate);
+      if (!raw.length) {
+        return { pending: true };
+      }
+      const merged = { hide: [], exceptions: [], generichide: false };
+      for (const r of parse(
+        raw
+      )) {
+        merged.hide.push(...(r.hide || []));
+        merged.exceptions.push(...(r.exceptions || []));
+        merged.generichide ||= !!r.generichide;
+      }
+      if (debug) {
+        trace(`hide=${merged.hide.length} generichide=${merged.generichide}`);
+      }
+      return merged;
+    }
+    if (message.name === "Obscurant:CosmeticGeneric") {
+      const now = Date.now();
+      if (now - (this._lastGeneric || 0) < 150) {
+        return null;
+      }
+      this._lastGeneric = now;
+      const cap = list =>
+        Array.isArray(list)
+          ? list
+              .filter(x => typeof x === "string" && x.length <= 128)
+              .slice(0, 2000)
+          : [];
+      const classes = cap(message.data.classes);
+      const ids = cap(message.data.ids);
+      const exceptions = cap(message.data.exceptions);
+      const out = [];
+      for (const list of parse(
+        svc.getHiddenClassIdSelectors(
+          classes.join("\n"),
+          ids.join("\n"),
+          exceptions.join("\n"),
+          state.isPrivate
+        )
+      )) {
+        out.push(...list);
+      }
+      if (debug) {
+        trace(`generic selectors=${out.length}`);
+      }
+      return out;
+    }
+    return null;
+  }
+}
