+function el(tag, props = {}, ...kids) {
+  const node = document.createElementNS(HTML, tag);
+  for (const [key, value] of Object.entries(props)) {
+    if (key === "text") {
+      node.textContent = value;
+    } else if (key.startsWith("on")) {
+      node.addEventListener(key.slice(2), value);
+    } else {
+      node.setAttribute(key, value);
+    }
+  }
+  node.append(...kids);
+  return node;
+}
+
+function renderStatus() {
+  const on = Services.prefs.getBoolPref("obscurant.voice.enabled", false);
+  const wake = Services.prefs.getStringPref("obscurant.voice.wake", "hey obscurity");
+  const key = Services.prefs.getStringPref("obscurant.voice.key", "");
+  const always = Services.prefs.getBoolPref("obscurant.voice.wake_enabled", true);
+  $("status").textContent = on
+    ? `On. ${always ? `Say "${wake}".` : "The microphone is closed until you press the key."}${key ? ` Push-to-talk: ${key}.` : ""}`
+    : "Off. Turn it on to use your voice.";
+  $("toggle").textContent = on ? "Turn off" : "Turn on";
+}
+
+function renderShortcuts() {
+  const list = $("shortcut-list");
+  list.replaceChildren();
+  const entries = Object.entries(V.shortcuts());
+  if (!entries.length) {
+    list.append(el("div", { class: "row" }, el("span", { text: "None yet. Say \"remember this as work\" on any page, or add one below." })));
+  }
+  for (const [name, url] of entries) {
+    list.append(
+      el(
+        "div",
+        { class: "row" },
+        el("code", { text: name }),
+        el("span", { text: url }),
+        el("button", {
+          class: "btn small",
+          type: "button",
+          text: "Try",
+          onclick: () => V.handle(`open ${name}`),
+        }),
+        el("button", {
+          class: "btn small danger",
+          type: "button",
+          text: "Delete",
+          onclick: () => {
+            const map = V.shortcuts();
+            delete map[name];
+            V.setShortcuts(map);
+            renderShortcuts();
+          },
+        })
+      )
+    );
+  }
+}
+
+function renderGroups() {
+  const q = $("filter").value.trim().toLowerCase();
+  const holder = $("groups");
+  holder.replaceChildren();
+  for (const group of COMMAND_DOCS) {
+    const items = group.items.filter(i => !q || i.say.toLowerCase().includes(q) || i.does.toLowerCase().includes(q) || group.title.toLowerCase().includes(q));
+    if (!items.length) {
+      continue;
+    }
+    const box = el("section", { class: "group" }, el("h2", { text: group.title }));
+    for (const item of items) {
+      box.append(
+        el(
+          "div",
+          { class: "cmd" },
