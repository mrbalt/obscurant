+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const INTRO_MS = 2800;
+const DEFAULT_THEME = "blackglass@local";
+const MEMORY_MODES = { balanced: 600000, lean: 180000 };
+
+const stage = document.getElementById("stage");
+const themeGrid = document.getElementById("themes");
+
+function whenReady(fnName) {
+  return new Promise(resolve => {
+    let tries = 0;
+    const check = () => {
+      if (typeof window[fnName] === "function" || ++tries > 50) {
+        resolve(typeof window[fnName] === "function");
+        return;
+      }
+      setTimeout(check, 100);
+    };
+    check();
+  });
+}
+
+const statusEl = document.getElementById("status");
+
+function setStatus(text) {
+  statusEl.textContent = text;
+}
+
+async function sendAction(action) {
+  if (!(await whenReady("AWSendToParent"))) {
+    throw new Error("The browser connection is not available yet");
+  }
+  await window.AWSendToParent("SPECIAL_ACTION", action);
+}
+
+function scramble(el, finalText, duration) {
+  const glyphs = "01/\\#<>=+*";
+  const start = performance.now();
+  const step = now => {
+    const t = Math.min(1, (now - start) / duration);
+    const settled = Math.floor(t * finalText.length);
+    let out = "";
+    for (let i = 0; i < finalText.length; i++) {
+      out +=
+        i < settled
+          ? finalText[i]
+          : glyphs[Math.floor(Math.random() * glyphs.length)];
+    }
+    el.textContent = out;
+    if (t < 1) {
+      requestAnimationFrame(step);
+    } else {
+      el.textContent = finalText;
+    }
+  };
+  requestAnimationFrame(step);
+}
+
+function applyPalette(theme) {
+  const root = document.documentElement.style;
+  root.setProperty("--bg", theme.frame);
+  root.setProperty("--panel", theme.toolbar);
+  root.setProperty("--field", theme.field);
+  root.setProperty("--text", theme.text);
+  root.setProperty("--sub", theme.sub);
+  root.setProperty("--accent", theme.accent);
+  root.setProperty("--border", theme.border);
+}
+
+async function selectTheme(theme, button) {
+  for (const b of themeGrid.children) {
+    b.setAttribute("aria-checked", b === button ? "true" : "false");
+  }
+  applyPalette(theme);
+  if (!(await whenReady("AWSelectTheme"))) {
+    return;
+  }
+  for (let attempt = 0; attempt < 8; attempt++) {
+    try {
+      await window.AWSelectTheme(theme.id);
+      return;
+    } catch (ex) {
+      // The theme may still be installing on first run.
+      await new Promise(r => setTimeout(r, 600));
+    }
+  }
+}
+
+function buildThemes() {
+  let initial = null;
+  let index = 0;
+  for (const theme of window.OBSCURANT_THEMES) {
+    const button = document.createElement("button");
+    button.type = "button";
+    button.className = "theme";
+    button.setAttribute("role", "radio");
+    button.setAttribute("aria-checked", "false");
+    button.title = theme.name;
+    button.style.setProperty("--i", index++);
+
+    const chip = document.createElement("span");
+    chip.className = "chip";
+    const top = document.createElement("span");
+    top.className = "top";
+    top.style.background = theme.frame;
+    const body = document.createElement("span");
+    body.className = "body";
+    body.style.background = theme.toolbar;
+    const dot = document.createElement("span");
+    dot.className = "dot";
+    dot.style.background = theme.accent;
+    body.append(dot);
+    chip.append(top, body);
+
+    const label = document.createElement("span");
+    label.textContent = theme.name;
+
+    button.append(chip, label);
+    button.addEventListener("click", () => selectTheme(theme, button));
+    themeGrid.append(button);
+
+    if (theme.id == DEFAULT_THEME) {
+      initial = { theme, button };
+    }
+  }
+  if (initial) {
+    initial.button.setAttribute("aria-checked", "true");
+    applyPalette(initial.theme);
+  }
+}
+
+function setupMemory() {
+  const buttons = document.querySelectorAll("#memory button");
+  for (const button of buttons) {
+    button.addEventListener("click", () => {
+      for (const b of buttons) {
+        b.setAttribute("aria-checked", b === button ? "true" : "false");
+      }
+      sendAction({
+        type: "SET_PREF",
+        data: {
+          pref: {
+            name: "browser.tabs.unloadInactiveAfterMs",
+            value: MEMORY_MODES[button.dataset.mode],
+          },
+        },
+      });
+    });
+  }
+}
+
+function showSetup() {
+  stage.dataset.state = "setup";
+}
+
+function init() {
+  const nameText = document.getElementById("name-text");
+  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+    setTimeout(() => scramble(nameText, "Obscurant", 1300), 550);
+  }
+  buildThemes();
+  setupMemory();
+
+  document
+    .getElementById("make-default")
+    .addEventListener("click", async () => {
+      setStatus("Setting as default...");
+      try {
+        await sendAction({ type: "SET_DEFAULT_BROWSER" });
+        setStatus("Done. Check your system's default apps if links still open elsewhere.");
+      } catch (ex) {
+        setStatus("Could not set the default. Use your system's default apps settings.");
+      }
+    });
+  document.getElementById("start").addEventListener("click", async () => {
+    // The browser opens the new tab for us. The page must not navigate there itself: the new tab
+    // lives in the browser's own process, and the browser refuses (and stops) such a load.
+    try {
+      await sendAction({
+        type: "OPEN_URL",
+        data: { args: "about:home", where: "current" },
+      });
+    } catch (ex) {
+      console.error("Start browsing: the browser did not take the request:", ex);
+      setStatus("Could not open the new tab. Press Ctrl+T.");
+    }
+  });
+
+  const skip = () => showSetup();
+  const timer = setTimeout(showSetup, INTRO_MS);
+  document.addEventListener(
+    "pointerdown",
+    () => {
+      clearTimeout(timer);
+      skip();
+    },
+    { once: true }
+  );
+  document.addEventListener(
+    "keydown",
+    () => {
+      clearTimeout(timer);
+      skip();
+    },
+    { once: true }
+  );
+}
+
+init();
+
+// Developer check only: with the dev pref set, the page presses its own Start button.
+if (typeof RPMGetBoolPref === "function" && RPMGetBoolPref("obscurant.dev.click_auto", false)) {
+  setTimeout(() => document.getElementById("start")?.click(), 3500);
+}
