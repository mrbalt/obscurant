+
+/* ---- Things Obscurant does not have: hidden everywhere ---- */
+#firefox-view-button, #ai-window-toggle, #fxa-toolbar-menu-button,
+#sidebar-button.ai,
+/* menubar */
+#helpMenu, #menu_newAIWindow, #menu_sendLink, #menu_openFirefoxView,
+#chatsHistoryMenu, #recentChatsHeader, #sync-enable, #sync-reauthitem, #sync-setup,
+#sync-syncnowitem, #sync-tabs-menuitem, #sync-unverifieditem, #feedbackPage,
+#helpSwitchDevice, #helpSafeMode, #troubleShooting, #help_reportBrokenSite,
+/* page context menu */
+#context-sendlinktodevice, #context-sendpagetodevice, #context-sendimage,
+#context-sendvideo, #context-sendaudio, #context-openlinksmartwindow,
+#context-previewlink, #context-take-screenshot, #context-sep-screenshots,
+#context-translate-selection, #use-relay-mask, #context-media-eme-learnmore,
+#context-openlinkinsplitview {
+  display: none !important;
+}
+
+/* ---- Obscurant main menu ---- */
+#obscurant-menu {
+  --panel-background: transparent;
+  --panel-border-color: transparent;
+  --panel-shadow: none;
+  --panel-padding: 0;
+  --arrowpanel-background: transparent;
+  --arrowpanel-border-color: transparent;
+  --arrowpanel-padding: 0;
+  --arrowpanel-border-radius: 16px;
+  appearance: none;
+  background: transparent;
+  border: none;
+}
+
+#obscurant-menu::part(content) {
+  background: rgba(14, 16, 22, 0.94);
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 16px;
+  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
+  color: #f2f4f8;
+}
+
+.om-root {
+  width: 300px;
+  padding: 8px;
+  font: 13px system-ui, sans-serif;
+}
+
+.om-head {
+  display: flex;
