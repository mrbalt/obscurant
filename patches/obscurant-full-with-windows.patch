+
+export class ObscurantCosmeticParent extends JSWindowActorParent {
+  _allowed() {
+    if (
+      !Services.prefs.getBoolPref(BLOCK_PREF, false) ||
+      !Services.prefs.getBoolPref(COSMETIC_PREF, true)
+    ) {
+      return null;
+    }
+    const browser = this.manager.browsingContext.top.embedderElement;
+    if (!browser) {
+      return null;
+    }
+    try {
+      if (
+        lazy.ContentBlockingAllowList.canHandle(browser) &&
+        lazy.ContentBlockingAllowList.includes(browser)
+      ) {
+        return null;
+      }
+    } catch (ex) {
+      // Treat as not allowed to be on the list.
+    }
