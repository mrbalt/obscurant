+function keyRow({ pref, label, desc, keywords = "" }) {
+  const btn = el("button", { class: "btn", type: "button" });
+  const show = () => {
+    btn.textContent = readPref(pref, "") || "Not set. Click to set";
+  };
+  let capturing = false;
+  const onKey = event => {
+    event.preventDefault();
+    event.stopPropagation();
+    if (event.key === "Escape") {
+      stop();
+      return;
+    }
+    if (event.key === "Backspace" || event.key === "Delete") {
+      writePref(pref, "");
+      stop();
+      return;
+    }
+    if (["Control", "Shift", "Alt", "Meta"].includes(event.key)) {
+      return;
+    }
+    const mods = [event.ctrlKey && "Ctrl", event.altKey && "Alt", event.shiftKey && "Shift", event.metaKey && "Meta"].filter(Boolean);
+    const isFunctionKey = /^F([1-9]|1[0-2])$/.test(event.key);
+    if (!mods.length && !isFunctionKey) {
+      toast("Add Ctrl, Alt or Shift, or use a function key");
+      return;
+    }
+    const name = event.key === " " ? "Space" : event.key.length === 1 ? event.key.toUpperCase() : event.key;
+    writePref(pref, [...mods, name].join("+"));
+    stop();
+  };
+  const stop = () => {
+    capturing = false;
+    window.removeEventListener("keydown", onKey, true);
+    show();
+  };
+  btn.addEventListener("click", () => {
+    if (capturing) {
+      stop();
+      return;
+    }
+    capturing = true;
+    btn.textContent = "Press the keys... (Esc cancels, Backspace clears)";
+    window.addEventListener("keydown", onKey, true);
+  });
+  watch(pref, show);
+  show();
+  return row(label, desc, btn, keywords);
+}
