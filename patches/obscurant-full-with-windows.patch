+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* AI filters for the shield. Four independent parts, each its own pref:
+ *   obscurant.ai.hide    hide AI answers / AI chat buttons on search pages and sites
+ *   obscurant.ai.skip    skip Shorts / TikToks the platform itself labels as AI
+ *   obscurant.ai.images  blur images that are labeled or hosted as AI-generated
+ *   obscurant.ai.block_sites (handled in ObscurantLists: a block list of generator sites)
+ * Nothing here can recognise AI content that nobody labeled. */
+
+const MAX_SCANS = 30;
+const MAX_IMAGES = 800;
+
+const SEARCH_HOST = /(^|\.)(google\.[a-z.]+|bing\.com|duckduckgo\.com|search\.brave\.com|search\.yahoo\.com|ecosia\.org|startpage\.com|kagi\.com)$/;
+const HEADING_AI = /^(AI Overviews?|AI Mode|Copilot( Search)?|Generative AI|Search Assist|Answer from AI|DuckAssist|Quick Answer|Learn more with AI|Ask AI|AI-generated (answer|summary))\b/i;
+const AI_BUTTON = /^(ask|chat with|open|try|talk to)\s+(ai|copilot|gemini|assistant|meta ai|grok|chatgpt)\b|^(ai (assistant|chat|mode)|summarize with ai|ask ai)$/i;
+
+// Image hosts that serve mostly generated images.
+const AI_IMAGE_HOSTS = [
+  "cdn.midjourney.com",
+  "mj-gallery.com",
+  "cdn.leonardo.ai",
+  "cdn.openart.ai",
+  "images.civitai.com",
+  "image.civitai.com",
+  "lexica.art",
+  "cdn.nightcafe.studio",
+  "ideogram.ai",
+  "cdn.tensor.art",
+  "image.tensor.art",
+  "cdn.seaart.ai",
+  "oaidalleapiprodscus.blob.core.windows.net",
+  "cdn.stablediffusionapi.com",
+  "playground.com",
+  "cdn.krea.ai",
+];
+const AI_TEXT = /\b(ai[- ]generated|generated (by|with|using) (ai|midjourney|dall[- ]?e|stable diffusion|firefly|gemini|chatgpt|flux|sora)|made with ai|created with ai|ai[- ]created|synthetic (image|media)|midjourney|dall[- ]?e|stable diffusion)\b/i;
+const AI_FILE = /(midjourney|dall-?e|stable[-_]?diffusion|ai[-_]generated|ai[-_]art)/i;
+const VIDEO_LABEL = /(altered or synthetic content|ai[- ]generated|made with ai|ai[- ]created|synthetic media)/i;
+
+export const AI = {
+  isSearchHost(host) {
+    return (
+      SEARCH_HOST.test(host || "") ||
+      Services.prefs.getBoolPref("obscurant.dev.ai_any_host", false)
+    );
+  },
+
+  start(win, opts) {
+    const doc = win.document;
+    const host = win.location.hostname.toLowerCase();
+    if (opts.hide) {
+      this._hide(win, doc, host);
+    }
+    if (opts.images) {
+      this._images(win, doc);
+    }
+    if (opts.skip) {
+      this._skip(win, doc, host);
+    }
+  },
+
+  /* ---- hide AI answers and chat buttons ---- */
+  _hide(win, doc, host) {
+    const hidden = new WeakSet();
+    const hide = el => {
+      if (el && !hidden.has(el)) {
+        hidden.add(el);
+        el.style.setProperty("display", "none", "important");
+        el.setAttribute("data-obscurant-ai-hidden", "");
+      }
+    };
+    const blockFor = heading => {
+      // Highest ancestor that still holds no ordinary results.
+      let best = heading;
+      let node = heading.parentElement;
+      for (let i = 0; node && i < 12; i++, node = node.parentElement) {
+        if (
+          node === doc.body ||
+          node === doc.documentElement ||
+          /^(MAIN|BODY|HTML)$/.test(node.tagName) ||
+          node.id === "search" ||
+          node.id === "rso" ||
+          node.id === "b_results"
+        ) {
+          break;
+        }
+        if (node.querySelectorAll("a h3, li.b_algo, [data-testid=result]").length > 1) {
+          break;
+        }
+        best = node;
+      }
+      return best;
+    };
+    const scan = () => {
+      if (this.isSearchHost(host)) {
+        for (const h of doc.querySelectorAll("h1, h2, h3, h4, [role=heading]")) {
+          const t = (h.textContent || "").trim();
+          if (t.length < 60 && HEADING_AI.test(t)) {
+            hide(blockFor(h));
+          }
+        }
+        // The "AI Mode" tab / link in the search bar.
+        for (const a of doc.querySelectorAll("a, button, [role=tab]")) {
+          const t = (a.textContent || "").trim();
+          if (t.length < 24 && /^AI Mode$/i.test(t)) {
+            hide(a.closest("[role=listitem], li") || a);
+          }
+        }
+      }
+      for (const b of doc.querySelectorAll("button, a[role=button], [role=button]")) {
+        const label = ((b.getAttribute("aria-label") || b.textContent || "").trim()).slice(0, 60);
+        if (label && AI_BUTTON.test(label)) {
+          hide(b);
+        }
+      }
+    };
+    this._watch(win, doc, scan);
+  },
+
+  /* ---- blur AI images ---- */
+  _images(win, doc) {
+    const done = new WeakSet();
+    let count = 0;
+    const isAI = img => {
+      const src = img.currentSrc || img.src || "";
+      try {
+        const u = new win.URL(src, doc.baseURI);
+        if (AI_IMAGE_HOSTS.some(h => u.hostname === h || u.hostname.endsWith("." + h))) {
+          return true;
+        }
+        if (AI_FILE.test(u.pathname.split("/").pop() || "")) {
+          return true;
+        }
+      } catch (ex) {
+        // Not a URL.
+      }
+      const text = [
+        img.alt,
+        img.title,
+        img.getAttribute("aria-label"),
+        img.closest("figure")?.querySelector("figcaption")?.textContent,
+      ]
+        .filter(Boolean)
+        .join(" ")
+        .slice(0, 300);
+      return AI_TEXT.test(text);
+    };
+    const blur = img => {
+      img.style.setProperty("filter", "blur(26px) saturate(0.6)", "important");
+      img.style.setProperty("cursor", "pointer", "important");
+      img.dataset.obscurantAiImage = "1";
+      const old = img.title;
+      img.title = "AI-generated image (labeled). Click to show.";
+      img.addEventListener(
+        "click",
+        e => {
+          if (img.dataset.obscurantAiImage === "1") {
+            e.preventDefault();
+            e.stopPropagation();
+            img.dataset.obscurantAiImage = "0";
+            img.style.removeProperty("filter");
+            img.style.removeProperty("cursor");
+            img.title = old;
+          }
+        },
+        true
+      );
+    };
+    const scan = () => {
+      for (const img of doc.images) {
+        if (count >= MAX_IMAGES) {
+          return;
+        }
+        if (done.has(img)) {
+          continue;
+        }
+        done.add(img);
+        count++;
+        if (isAI(img)) {
+          blur(img);
+        }
+      }
+    };
+    this._watch(win, doc, scan);
+  },
+
+  /* ---- skip videos the platform labels as AI ---- */
+  _skip(win, doc, host) {
+    const anyHost = Services.prefs.getBoolPref("obscurant.dev.ai_any_host", false);
+    const yt =
+      (/(^|\.)youtube\.com$/.test(host) || anyHost) &&
+      win.location.pathname.startsWith("/shorts");
+    const tt = /(^|\.)tiktok\.com$/.test(host);
+    if (!yt && !tt) {
+      return;
+    }
+    let skipped = 0;
+    let lastKey = "";
+    const next = () => {
+      skipped++;
+      if (yt) {
+        const btn =
+          doc.querySelector("#navigation-button-down button") ||
+          doc.querySelector("#navigation-button-down");
+        if (btn) {
+          btn.click();
+          return;
+        }
+      }
+      const ev = new win.KeyboardEvent("keydown", { key: "ArrowDown", code: "ArrowDown", keyCode: 40, bubbles: true });
+      (doc.activeElement || doc.body).dispatchEvent(ev);
+      doc.dispatchEvent(ev);
+    };
+    const timer = win.setInterval(() => {
+      if (skipped > 200) {
+        win.clearInterval(timer);
+        return;
+      }
+      const active = yt
+        ? doc.querySelector("ytd-reel-video-renderer[is-active]")
+        : doc.querySelector("[data-e2e=recommend-list-item-container]:has(video[src]), article:has(video)");
+      if (!active) {
+        return;
+      }
+      const text = (active.textContent || "").slice(0, 4000);
+      const key = (active.id || "") + text.slice(0, 80);
+      if (key === lastKey) {
+        return;
+      }
+      if (VIDEO_LABEL.test(text)) {
+        lastKey = key;
+        next();
+      }
+    }, 900);
+    win.addEventListener("pagehide", () => win.clearInterval(timer), { once: true });
+  },
+
+  /* Run `scan` now and after page changes, a limited number of times. */
+  _watch(win, doc, scan) {
+    let scans = 0;
+    let timer = 0;
+    const run = () => {
+      timer = 0;
+      scans++;
+      try {
+        scan();
+      } catch (ex) {
+        // A page we cannot read.
+      }
+    };
+    run();
+    const observer = new win.MutationObserver(() => {
+      if (timer || scans >= MAX_SCANS) {
+        if (scans >= MAX_SCANS) {
+          observer.disconnect();
+        }
+        return;
+      }
+      timer = win.setTimeout(run, 700);
+    });
+    if (doc.documentElement) {
+      observer.observe(doc.documentElement, { childList: true, subtree: true });
+    }
+    win.addEventListener("pagehide", () => observer.disconnect(), { once: true });
+  },
+};
+
+/* Skips sponsor and similar segments on YouTube using the SponsorBlock database.
+ * The segment lookup is done by the parent process (hashed video id prefix only, no
+ * cookies, no referrer); this part watches the player and seeks past a segment. */
+const SB_LABELS = {
+  sponsor: "sponsor",
+  selfpromo: "self-promotion",
+  interaction: "interaction reminder",
+  intro: "intro",
+  outro: "outro",
+  preview: "recap",
+  music_offtopic: "non-music section",
+};
+
+export const SponsorBlock = {
+  start(win, ask) {
+    const doc = win.document;
+    let videoId = "";
+    let segments = [];
+    let ignored = new Set();
+    const idFromUrl = () => {
+      try {
+        const u = new win.URL(win.location.href);
+        if (u.pathname === "/watch") {
+          const v = u.searchParams.get("v");
+          return /^[\w-]{11}$/.test(v || "") ? v : "";
+        }
+        const m = u.pathname.match(/^\/(?:shorts|embed|live)\/([\w-]{11})/);
+        return m ? m[1] : "";
+      } catch (ex) {
+        return "";
+      }
+    };
+    const notice = (seg, video) => {
+      try {
+        doc.getElementById("obscurant-sb-notice")?.remove();
+        const host = doc.querySelector(".html5-video-player") || doc.body;
+        const box = doc.createElement("div");
+        box.id = "obscurant-sb-notice";
+        box.style.cssText =
+          "position:absolute;left:16px;bottom:72px;z-index:2147483647;background:rgba(10,12,18,.88);color:#e8eaf2;font:13px system-ui,sans-serif;padding:8px 12px;border-radius:8px;display:flex;gap:12px;align-items:center;";
+        box.append(doc.createTextNode("Skipped " + (SB_LABELS[seg.c] || seg.c)));
+        const undo = doc.createElement("button");
+        undo.textContent = "Undo";
+        undo.style.cssText = "background:#3b82f6;color:#fff;border:0;border-radius:6px;padding:3px 9px;cursor:pointer;";
+        undo.addEventListener("click", () => {
+          ignored.add(seg.id);
+          video.currentTime = seg.s;
+          box.remove();
+        });
+        box.append(undo);
+        host.append(box);
+        win.setTimeout(() => box.remove(), 4500);
+      } catch (ex) {
+        // The page layout changed; skipping still works without the notice.
+      }
+    };
+    const tick = () => {
+      const id = idFromUrl();
+      if (id !== videoId) {
+        videoId = id;
+        segments = [];
+        ignored = new Set();
+        if (id) {
+          ask(id).then(list => {
+            if (videoId === id && Array.isArray(list)) {
+              segments = list;
+            }
+          }).catch(() => {});
+        }
+      }
+      if (!segments.length) {
+        return;
+      }
+      const video = doc.querySelector("video.html5-main-video") || doc.querySelector("video");
+      if (!video || video.seeking) {
+        return;
+      }
+      const t = video.currentTime;
+      for (const seg of segments) {
+        if (!ignored.has(seg.id) && t >= seg.s - 0.05 && t < seg.e - 0.25) {
+          video.currentTime = seg.e;
+          notice(seg, video);
+          break;
+        }
+      }
+    };
+    const timer = win.setInterval(tick, 200);
+    win.addEventListener("pagehide", () => win.clearInterval(timer), { once: true });
+  },
+};
