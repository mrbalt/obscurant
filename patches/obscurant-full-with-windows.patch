+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  YouTube: "resource:///actors/ObscurantYouTube.sys.mjs",
+  AI: "resource:///actors/ObscurantAI.sys.mjs",
+  SponsorBlock: "resource:///actors/ObscurantAI.sys.mjs",
+});
+
+const MAX_ELEMENTS = 4000;
+const MAX_NAMES = 2000;
+const MAX_SEEN = 20000;
+const CHUNK = 400;
+const RULE = " { display: none !important; }";
+
+export class ObscurantCosmeticChild extends JSWindowActorChild {
+  _seenClasses = new Set();
+  _seenIds = new Set();
+  _exceptions = [];
+  _generic = true;
+  _sheets = [];
+
+  handleEvent(event) {
+    if (event.type === "DOMDocElementInserted") {
+      this._startYouTube();
+      this._started = true;
+      this._start().catch(ex =>
+        this.sendAsyncMessage("Obscurant:Log", `child error: ${ex}`)
+      );
+    } else if (event.type === "DOMContentLoaded") {
+      this._startAI().catch(() => {});
+      if (this._ready) {
+        this._scan().catch(() => {});
+      }
+    }
+  }
+
+  // Voice commands that act on the page: scrolling and (when dictation is on) typing.
+  receiveMessage(message) {
+    if (message.name !== "Obscurant:Voice") {
+      return;
+    }
+    const win = this.contentWindow;
+    const doc = this.document;
+    const { action, where, text, amount, op, value, n } = message.data || {};
+    if (!win || !doc) {
+      return;
+    }
+    if (action === "scroll") {
+      const page = Math.max(120, Math.round(win.innerHeight * 0.85 * (amount || 1)));
+      if (where === "down") {
+        win.scrollBy({ top: page, behavior: "smooth" });
+      } else if (where === "up") {
+        win.scrollBy({ top: -page, behavior: "smooth" });
+      } else if (where === "top") {
+        win.scrollTo({ top: 0, behavior: "smooth" });
+      } else if (where === "bottom") {
+        win.scrollTo({ top: doc.documentElement.scrollHeight, behavior: "smooth" });
+      }
+    } else if (action === "media") {
+      const players = [...doc.querySelectorAll("video, audio")];
+      const el = players.find(p => !p.paused) || players.sort((x, y) => y.clientWidth * y.clientHeight - x.clientWidth * x.clientHeight)[0];
+      if (el) {
+        if (op === "pause") {
+          el.pause();
+        } else if (op === "play") {
+          el.play();
+        } else if (op === "seek") {
+          el.currentTime = Math.max(0, el.currentTime + value);
+        } else if (op === "volume") {
+          el.volume = Math.min(1, Math.max(0, el.volume + value));
+        } else if (op === "rate") {
+          el.playbackRate = Math.min(3, Math.max(0.25, el.playbackRate + value));
+        } else if (op === "rate-reset") {
+          el.playbackRate = 1;
+        }
+      }
+    } else if (action === "hints-show") {
+      this._hideHints();
+      const box = doc.createElement("div");
+      box.id = "obscurant-hints";
+      const links = [];
+      for (const a of doc.querySelectorAll("a[href]")) {
+        const r = a.getBoundingClientRect();
+        if (links.length >= 40 || r.width < 8 || r.height < 8 || r.bottom < 0 || r.top > win.innerHeight || r.right < 0 || r.left > win.innerWidth) {
+          continue;
+        }
+        let url;
+        try {
+          url = new win.URL(a.href);
+        } catch (ex) {
+          continue;
+        }
+        if (!/^https?:$/.test(url.protocol)) {
+          continue;
+        }
+        links.push(a);
+        const tag = doc.createElement("span");
+        tag.textContent = String(links.length);
+        tag.style.cssText = `position:fixed;left:${Math.max(0, r.left)}px;top:${Math.max(0, r.top)}px;z-index:2147483647;background:#ffd84d;color:#111;font:bold 12px system-ui,sans-serif;padding:1px 5px;border-radius:5px;border:1px solid #111;pointer-events:none;`;
+        box.append(tag);
+      }
+      doc.documentElement.append(box);
+      this._hintLinks = links;
+      this._hintTimer = win.setTimeout(() => this._hideHints(), 20000);
+    } else if (action === "hints-hide") {
+      this._hideHints();
+    } else if (action === "hints-click") {
+      const link = this._hintLinks?.[n - 1];
+      this._hideHints();
+      if (link && link.isConnected) {
+        link.click();
+      }
+    } else if (action === "type" && typeof text === "string" && text.length <= 400) {
+      // Only into something you could already type in; never a password box.
+      const el = doc.activeElement;
+      const typeable =
+        el &&
+        ((el.tagName === "INPUT" && !/^(password|file|hidden|checkbox|radio|submit|button)$/i.test(el.type)) ||
+          el.tagName === "TEXTAREA" ||
+          el.isContentEditable);
+      if (typeable) {
+        doc.execCommand("insertText", false, text);
+      }
+    }
+  }
+
+  _hideHints() {
+    this.document?.getElementById("obscurant-hints")?.remove();
+    this._hintLinks = null;
+    this.contentWindow?.clearTimeout(this._hintTimer);
+  }
+
+  // AI filters (hide AI answers, skip labeled AI videos, blur AI images).
+  async _startAI() {
+    const win = this.contentWindow;
+    const url = this.document?.documentURI;
+    if (!win || !url || !/^https?:/.test(url) || this._aiStarted) {
+      return;
+    }
+    this._aiStarted = true;
+    const opts = await this.sendQuery("Obscurant:AI");
+    if (opts) {
+      lazy.AI.start(win, opts);
+    }
+  }
+
+  async _startYouTube() {
+    const url = this.document?.documentURI;
+    if (
+      !url ||
+      !(lazy.YouTube.isYouTube(url) || Services.prefs.getBoolPref("obscurant.dev.ai_any_host", false)) ||
+      this._youtube
+    ) {
+      return;
+    }
+    this._youtube = true;
+    const win = this.contentWindow;
+    // Start now, so the script is in place before YouTube's own scripts run;
+    // switch it off again if shields are off for this site.
+    lazy.YouTube.injectPageScript(win);
+    try {
+      if (await this.sendQuery("Obscurant:YouTube")) {
+        lazy.YouTube.startYouTubeAdBlock(win);
+        lazy.SponsorBlock.start(win, id => this.sendQuery("Obscurant:SponsorBlock", { id }));
+      } else {
+        lazy.YouTube.disablePageScript(win);
+      }
+    } catch (ex) {
+      // The page may be gone.
+    }
+  }
+
+  async _start(attempt = 0) {
+    const win = this.contentWindow;
+    const url = this.document?.documentURI;
+    if (!win || !url || !/^https?:/.test(url)) {
+      return;
+    }
+    const res = await this.sendQuery("Obscurant:Cosmetic", { url });
+    if (!res) {
+      return;
+    }
+    if (res.pending) {
+      if (attempt < 8) {
+        win.setTimeout(
+          () =>
+            this._start(attempt + 1).catch(ex =>
+              this.sendAsyncMessage("Obscurant:Log", `child error: ${ex}`)
+            ),
+          2500
+        );
+      }
+      return;
+    }
+    this._exceptions = res.exceptions || [];
+    this._generic = !res.generichide;
+    this._apply(res.hide || []);
+    this._ready = true;
+    if (this._generic) {
+      await this._scan();
+      this._watch();
+    }
+  }
+
+  _watch() {
+    const win = this.contentWindow;
+    const doc = this.document;
+    if (!win || !doc?.documentElement || this._observer) {
+      return;
+    }
+    let timer = 0;
+    let scans = 0;
+    this._observer = new win.MutationObserver(() => {
+      if (timer || scans >= 25) {
+        return;
+      }
+      timer = win.setTimeout(() => {
+        timer = 0;
+        scans++;
+        this._scan().catch(() => {});
+        if (scans >= 25) {
+          this._observer.disconnect();
+        }
+      }, 600);
+    });
+    this._observer.observe(doc.documentElement, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ["class", "id"],
+    });
+  }
+
+  didDestroy() {
+    this._observer?.disconnect();
+  }
+
+  async _scan() {
+    const doc = this.document;
+    if (!doc || !doc.documentElement) {
+      return;
+    }
+    const classes = [];
+    const ids = [];
+    const nodes = doc.querySelectorAll("[class], [id]");
+    const limit = Math.min(nodes.length, MAX_ELEMENTS);
+    for (let i = 0; i < limit; i++) {
+      const el = nodes[i];
+      if (
+        el.id &&
+        el.id.length <= 128 &&
+        ids.length < MAX_NAMES &&
+        !this._seenIds.has(el.id) &&
+        this._seenIds.size < MAX_SEEN
+      ) {
+        this._seenIds.add(el.id);
+        ids.push(el.id);
+      }
+      for (const c of el.classList || []) {
+        if (classes.length >= MAX_NAMES || this._seenClasses.size >= MAX_SEEN) {
+          break;
+        }
+        if (c.length <= 128 && !this._seenClasses.has(c)) {
+          this._seenClasses.add(c);
+          classes.push(c);
+        }
+      }
+    }
+    if (!classes.length && !ids.length) {
+      return;
+    }
+    const selectors = await this.sendQuery("Obscurant:CosmeticGeneric", {
+      classes,
+      ids,
+      exceptions: this._exceptions,
+    });
