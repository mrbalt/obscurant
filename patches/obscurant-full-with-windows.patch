+  "use strict";
+  if (window.__obscurantYT) {
+    return;
+  }
+  Object.defineProperty(window, "__obscurantYT", { value: true });
+  const KEYS = ["adPlacements", "adSlots", "playerAds", "adBreakHeartbeatParams"];
