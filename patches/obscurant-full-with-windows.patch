+  for (const theme of window.OBSCURANT_THEMES) {
+    const b = el("button", { class: "theme", type: "button", role: "radio", title: theme.name });
+    const top = el("span", { class: "top" });
+    top.style.background = theme.frame;
+    const body = el("span", { class: "body" });
+    body.style.background = theme.toolbar;
+    const dot = el("span", { class: "dot" });
+    dot.style.background = theme.accent;
+    body.append(dot);
+    b.append(el("span", { class: "chip" }, top, body), el("span", { text: theme.name }));
+    b.addEventListener("click", async () => {
+      try {
+        const addon = await AddonManager.getAddonByID(theme.id);
+        if (addon) {
+          await addon.enable();
+        }
+        paintPage(theme);
+        sync();
+      } catch (ex) {
+        toast("Could not switch theme");
+      }
+    });
+    buttons.set(theme.id, b);
+    wrap.append(b);
+  }
+  sync();
+  watch("extensions.activeThemeID", sync);
+  const c = card(wrap);
+  c.dataset.search = "theme appearance color dark light " +
+    window.OBSCURANT_THEMES.map(t => t.name.toLowerCase()).join(" ");
