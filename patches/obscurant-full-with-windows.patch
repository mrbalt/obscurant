+  filterEl.addEventListener("input", runFilter);
+  window.addEventListener("hashchange", routeFromHash);
+  watch("extensions.activeThemeID", applyActiveThemeToPage);
+  applyActiveThemeToPage();
+  routeFromHash();
+}
