+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+:root {
+  --bg: #121212;
+  --panel: #1f1f1f;
+  --field: #343434;
+  --text: #eeeeee;
+  --sub: #b4b4b4;
+  --accent: #ff5500;
+  --border: #4e5050;
+  --radius: 14px;
+  color-scheme: dark;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 14px/1.45 system-ui, sans-serif;
+  overflow: hidden;
+  transition: background-color 0.4s ease;
+}
+
+#glow {
+  position: fixed;
+  inset: -20%;
+  background:
+    radial-gradient(
+      ellipse 40% 35% at 70% 8%,
+      color-mix(in srgb, var(--accent) 16%, transparent),
+      transparent 70%
+    ),
+    radial-gradient(
+      ellipse 50% 40% at 10% 100%,
+      color-mix(in srgb, var(--accent) 8%, transparent),
+      transparent 70%
+    );
+  pointer-events: none;
+}
+
+#app {
+  position: relative;
+  display: grid;
+  grid-template-columns: 250px 1fr;
+  height: 100%;
+}
+
+#rail {
+  display: flex;
+  flex-direction: column;
+  padding: 22px 14px;
+  background: color-mix(in srgb, var(--panel) 70%, transparent);
+  border-inline-end: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
+  backdrop-filter: blur(18px) saturate(1.3);
+}
+
+#brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 0 10px 22px;
+}
+
+#brand-logo {
+  width: 34px;
+  height: 34px;
+  filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 50%, transparent));
+}
+
+#brand-name {
+  font-size: 19px;
+  font-weight: 300;
+  letter-spacing: 0.14em;
+}
+
+#nav {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  overflow-y: auto;
+}
+
+#nav button {
+  appearance: none;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: 100%;
+  padding: 10px 12px;
+  border: 0;
+  border-radius: 10px;
+  background: transparent;
+  color: var(--sub);
+  font: inherit;
+  text-align: start;
+  cursor: pointer;
+  transition:
+    background-color 0.18s ease,
+    color 0.18s ease;
+}
+
+#nav button:hover {
+  background: color-mix(in srgb, var(--field) 70%, transparent);
+  color: var(--text);
+}
+
+#nav button[aria-current="true"] {
+  background: color-mix(in srgb, var(--accent) 18%, transparent);
+  color: var(--text);
+  box-shadow: inset 3px 0 0 var(--accent);
+}
+
+#nav .dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--border);
+  flex: none;
+}
+
+#nav button[aria-current="true"] .dot {
+  background: var(--accent);
+  box-shadow: 0 0 10px var(--accent);
+}
+
+#rail-foot {
+  margin-top: auto;
+  padding: 12px 10px 0;
+  color: var(--sub);
+  font-size: 12px;
+}
+
+#main {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  height: 100%;
+  overflow: hidden;
+}
+
+#top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 22px 36px 14px;
+}
+
+#title {
+  margin: 0;
+  font-size: 24px;
+  font-weight: 300;
+  letter-spacing: 0.06em;
+}
+
+#filter {
+  width: min(320px, 40%);
+  padding: 9px 14px;
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--field) 70%, transparent);
+  color: var(--text);
+  font: inherit;
+  outline: none;
+  transition:
+    border-color 0.2s ease,
+    box-shadow 0.2s ease;
+}
+
+#filter:focus {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
+}
+
+#content {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 4px 36px 60px;
+  scrollbar-width: thin;
+  scrollbar-color: var(--border) transparent;
+}
+
+.section {
+  max-width: 780px;
+  margin: 0 0 28px;
+  animation: rise 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+.section[hidden] {
+  display: none;
+}
+
+.section > h2 {
+  margin: 8px 0 12px;
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--sub);
+}
+
+.card {
+  background: color-mix(in srgb, var(--panel) 78%, transparent);
+  border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--border));
+  border-radius: var(--radius);
+  backdrop-filter: blur(14px);
+  box-shadow: 0 10px 34px rgba(0, 0, 0, 0.35);
+  overflow: hidden;
+}
+
+.card + .card {
+  margin-top: 14px;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  padding: 15px 20px;
+}
+
+.row + .row {
+  border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
+}
+
+.row[hidden] {
+  display: none;
+}
+
+.text {
+  min-width: 0;
+}
+
+.label {
+  font-size: 14px;
+}
+
+.desc {
+  margin-top: 2px;
+  color: var(--sub);
+  font-size: 12.5px;
+}
+
+.ctl {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.switch {
+  appearance: none;
+  position: relative;
+  width: 44px;
+  height: 25px;
+  margin: 0;
+  border: 0;
+  border-radius: 999px;
+  background: var(--field);
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.switch::after {
+  content: "";
+  position: absolute;
+  top: 3px;
+  inset-inline-start: 3px;
+  width: 19px;
+  height: 19px;
+  border-radius: 50%;
+  background: #fff;
+  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.switch[aria-checked="true"] {
+  background: var(--accent);
+  box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 45%, transparent);
+}
+
+.switch[aria-checked="true"]::after {
+  transform: translateX(19px);
+}
+
+.seg {
+  display: inline-flex;
+  padding: 3px;
+  border-radius: 10px;
+  background: var(--field);
+}
+
+.seg button {
+  appearance: none;
+  padding: 6px 14px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--sub);
+  font: inherit;
+  cursor: pointer;
+  transition:
+    background-color 0.18s ease,
+    color 0.18s ease;
+}
+
+.seg button[aria-checked="true"] {
+  background: var(--accent);
+  color: #fff;
+}
+
+.btn,
+select,
+input[type="text"],
+input[type="number"] {
+  padding: 7px 14px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: var(--field);
+  color: var(--text);
+  font: inherit;
+}
+
+.btn {
+  appearance: none;
+  cursor: pointer;
+  transition: border-color 0.18s ease;
+}
+
+.btn:hover {
+  border-color: var(--accent);
+}
+
+.btn.primary {
+  border-color: transparent;
+  background: var(--accent);
+  color: #fff;
+}
+
+input[type="text"] {
+  width: 260px;
+}
+
+input[type="number"] {
+  width: 90px;
+}
+
+select {
+  min-width: 170px;
+}
+
+.themes {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
+  gap: 10px;
+  padding: 16px 20px 20px;
+}
+
+.theme {
+  appearance: none;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 8px;
+  border: 2px solid transparent;
+  border-radius: 12px;
+  background: var(--field);
+  color: var(--text);
+  font: inherit;
+  font-size: 12px;
+  text-align: start;
+  cursor: pointer;
+  transition:
+    border-color 0.18s ease,
+    transform 0.18s ease;
+}
+
+.theme:hover {
+  transform: translateY(-2px);
+}
+
+.theme[aria-checked="true"] {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
+}
+
+.chip {
+  display: grid;
+  grid-template-rows: 9px 1fr;
+  height: 34px;
+  border-radius: 7px;
+  overflow: hidden;
+}
+
+.chip .body {
+  display: flex;
+  align-items: center;
+  padding: 0 7px;
+}
+
+.chip .dot {
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+}
+
+.pill {
+  padding: 3px 10px;
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--accent) 20%, transparent);
+  color: var(--text);
+  font-size: 12px;
+}
+
+.pill.good {
+  background: color-mix(in srgb, #3ecf6e 22%, transparent);
+}
+
+.pill.warn {
+  background: color-mix(in srgb, #ffb020 24%, transparent);
+}
+
+.empty {
+  max-width: 780px;
+  padding: 40px 0;
+  color: var(--sub);
+  text-align: center;
+}
+
+#toast {
+  position: fixed;
+  inset-block-end: 22px;
+  inset-inline-start: 50%;
+  transform: translate(-50%, 20px);
+  padding: 10px 18px;
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--panel) 92%, transparent);
+  border: 1px solid var(--accent);
+  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
+  opacity: 0;
+  pointer-events: none;
+  transition:
+    opacity 0.25s ease,
+    transform 0.25s ease;
+}
+
+#toast.show {
+  opacity: 1;
+  transform: translate(-50%, 0);
+}
+
+button:focus-visible,
+select:focus-visible,
+input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+}
+
+@media (max-width: 760px) {
+  #app {
+    grid-template-columns: 1fr;
+  }
+
+  #rail {
+    display: none;
+  }
+
+  #top,
+  #content {
+    padding-inline: 18px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .section {
+    animation: none;
+  }
+
+  * {
+    transition: none !important;
+  }
+}
+
+/* Per-site permission view */
+.perm-list { display: grid; gap: 10px; padding: 4px 2px 2px; }
+.perm-site { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
+.perm-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
+.perm-items { display: grid; gap: 6px; }
+.perm-item { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 10px; }
+
+.pp-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 50;
+  display: grid;
+  place-items: center;
+  background: rgba(5, 7, 12, 0.72);
+  backdrop-filter: blur(6px);
+}
+
+.pp-card {
+  width: min(440px, 92vw);
+  padding: 24px;
+  border: 1px solid var(--border);
+  border-radius: 16px;
+  background: var(--bg, #0b0d12);
+}
+
+.pp-card h2 {
+  margin: 0 0 6px;
+  font-size: 18px;
+}
+
+.pp-card p {
+  margin: 0 0 6px;
+  color: var(--sub);
+}
+
+.pp-card label {
+  display: block;
+  margin: 14px 0 5px;
+  color: var(--sub);
+  font-size: 12px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.pp-card input,
+.pp-card select {
+  width: 100%;
+  padding: 9px 12px;
+  border: 1px solid var(--border);
+  border-radius: 9px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+}
+
+.pp-meter {
+  height: 5px;
+  margin-top: 8px;
+  border-radius: 3px;
+  background: rgba(127, 127, 127, 0.25);
+  overflow: hidden;
+}
+
+.pp-meter span {
+  display: block;
+  height: 100%;
+  width: 0;
+  background: #ff6b6b;
+  transition: width 0.15s ease, background-color 0.15s ease;
+}
+
+.pp-meter[data-level="1"] span {
+  background: #f0b84f;
+}
+
+.pp-meter[data-level="2"] span,
+.pp-meter[data-level="3"] span {
+  background: #54e08a;
+}
+
+.pp-note {
+  min-height: 18px;
+  margin-top: 4px;
+  color: var(--sub);
+  font-size: 12.5px;
+}
+
+.pp-error {
+  min-height: 18px;
+  margin-top: 10px;
+  color: #ff6b6b;
+  font-size: 13px;
+}
+
+.pp-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.vt-key {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+}
+
+.vt-key input {
+  min-width: 260px;
+  flex: 1;
+}
+
+.vt-help {
+  margin-top: 8px;
+}
+
+.vt-help summary {
+  cursor: pointer;
+  color: var(--accent);
+}
+
+.vt-help li {
+  margin: 4px 0;
+}
+
+.vt-msg:empty {
+  display: none;
+}
