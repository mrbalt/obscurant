+          el("span", { class: "does", text: item.does }),
+          item.say === "yes / no" ? el("span") : el("button", { class: "btn small", type: "button", text: "Try", onclick: () => V.handle(item.say) })
+        )
+      );
+    }
+    holder.append(box);
+  }
+}
+
+$("toggle").addEventListener("click", () => {
+  Services.prefs.setBoolPref("obscurant.voice.enabled", !Services.prefs.getBoolPref("obscurant.voice.enabled", false));
+});
+$("filter").addEventListener("input", renderGroups);
+$("shortcut-form").addEventListener("submit", event => {
+  event.preventDefault();
+  const name = $("sc-name").value.trim();
+  let url = $("sc-url").value.trim();
+  if (url && !/^[a-z]+:\/\//i.test(url)) {
+    url = `https://${url}`;
+  }
+  const map = V.shortcuts();
+  map[name] = url;
+  const before = Object.keys(map).length;
+  V.setShortcuts(map);
+  if (!name || Object.keys(V.shortcuts()).length < Math.min(before, 50) || !V.shortcuts()[name.toLowerCase().replace(/[^a-z0-9 ]+/g, " ").replace(/\s+/g, " ").trim()]) {
+    $("sc-error").textContent = "Enter a name and a web address like example.com.";
+    return;
+  }
+  $("sc-error").textContent = "";
+  $("shortcut-form").reset();
+  renderShortcuts();
+});
+
+for (const pref of ["obscurant.voice.enabled", "obscurant.voice.wake", "obscurant.voice.key", "obscurant.voice.wake_enabled"]) {
+  Services.prefs.addObserver(pref, renderStatus);
+}
+window.addEventListener("unload", () => {
+  for (const pref of ["obscurant.voice.enabled", "obscurant.voice.wake", "obscurant.voice.key", "obscurant.voice.wake_enabled"]) {
+    Services.prefs.removeObserver(pref, renderStatus);
+  }
+});
+
+function guarded(name, fn) {
+  try {
+    fn();
+  } catch (ex) {
+    const box = document.getElementById("groups");
+    box.append(el("div", { class: "group" }, el("h2", { text: `Problem in ${name}` }), el("p", { class: "hint", text: String(ex.stack || ex.message || ex) })));
+  }
+}
+
+guarded("status", renderStatus);
+guarded("commands", renderGroups);
+guarded("shortcuts", renderShortcuts);
+if (!Array.isArray(COMMAND_DOCS) || !COMMAND_DOCS.length) {
+  guarded("commands list", () => {
+    throw new Error(`COMMAND_DOCS is ${typeof COMMAND_DOCS}; shortcuts is ${typeof V.shortcuts}; module is an older copy`);
+  });
+}
