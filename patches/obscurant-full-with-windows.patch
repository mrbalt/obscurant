+
+let current = "general";
+
+function show(id) {
+  current = id;
+  filterEl.value = "";
+  for (const s of contentEl.querySelectorAll(".section")) {
+    s.hidden = s.dataset.id !== id;
+    for (const r of s.querySelectorAll(".row")) {
+      r.hidden = false;
+    }
+  }
+  for (const b of navEl.querySelectorAll("button")) {
+    b.setAttribute("aria-current", String(b.dataset.id === id));
+  }
+  const entry = NAV.find(n => n[0] === id);
+  titleEl.textContent = entry ? entry[1] : "Settings";
+  contentEl.scrollTop = 0;
+}
+
+function runFilter() {
+  const q = filterEl.value.trim().toLowerCase();
+  if (!q) {
+    show(current);
+    return;
+  }
+  titleEl.textContent = "Search results";
+  for (const b of navEl.querySelectorAll("button")) {
+    b.setAttribute("aria-current", "false");
+  }
+  let total = 0;
+  for (const s of contentEl.querySelectorAll(".section")) {
+    let any = 0;
+    for (const c of s.querySelectorAll(".card")) {
+      if (c.dataset.search) {
+        const hit = c.dataset.search.includes(q);
+        c.hidden = !hit;
+        any += hit ? 1 : 0;
+        continue;
+      }
+      c.hidden = false;
+      let inCard = 0;
+      for (const r of c.querySelectorAll(".row")) {
+        const hit = (r.dataset.search || r.textContent.toLowerCase()).includes(q);
+        r.hidden = !hit;
+        inCard += hit ? 1 : 0;
+      }
+      c.hidden = inCard == 0;
+      any += inCard;
+    }
+    s.hidden = any == 0;
+    total += any;
+  }
+  const old = contentEl.querySelector(".empty");
+  if (old) {
+    old.remove();
+  }
+  if (!total) {
+    contentEl.append(el("div", { class: "empty", text: "Nothing matches that." }));
+  }
+}
