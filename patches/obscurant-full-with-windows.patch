+    const siteFirst = text.match(new RegExp(`^(?:search|look up|find) (?:on )?(${siteNames}) (?:for )?(.{2,100})$`));
+    const siteLast = text.match(new RegExp(`^(?:search|look up|find) (?:for )?(.{2,100}) (?:on|in) (${siteNames})$`));
+    if (siteFirst || siteLast) {
