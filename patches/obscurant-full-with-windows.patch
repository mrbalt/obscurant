+  const out = [];
+  for (const seg of (mine?.segments || []).slice(0, 60)) {
+    const [s, e] = seg.segment || [];
+    if (
+      cats.includes(seg.category) &&
+      (!seg.actionType || seg.actionType === "skip") &&
+      Number.isFinite(s) && Number.isFinite(e) && s >= 0 && e > s && e - s < 7200
