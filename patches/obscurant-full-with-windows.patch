+    return null;
+  }
+  if (!/^[a-z][a-z0-9+.-]*:/i.test(text)) {
+    text = "https://" + text;
+  }
+  try {
+    const url = new URL(text);
+    return /^https?:$/.test(url.protocol) && url.hostname.includes(".") ? url.href : null;
+  } catch (ex) {
+    return null;
+  }
+}
+
+function loadConfig() {
+  const cfg = { font: FONTS[0], nameColor: "#ffffff", logoColor: null, shortcuts: null, layout: {} };
+  try {
+    const raw = JSON.parse(Services.prefs.getStringPref(PREF, "{}"));
+    if (FONTS.includes(raw.font)) {
+      cfg.font = raw.font;
+    }
+    if (HEX.test(raw.nameColor)) {
+      cfg.nameColor = raw.nameColor;
+    }
+    if (HEX.test(raw.logoColor)) {
+      cfg.logoColor = raw.logoColor;
+    }
+    if (Array.isArray(raw.shortcuts)) {
+      cfg.shortcuts = raw.shortcuts
+        .map(s => ({ title: String(s.title || "").slice(0, 40), url: cleanUrl(s.url) }))
+        .filter(s => s.url)
+        .slice(0, 12);
+    }
+    const keys = Object.keys(raw.layout || {})
+      .filter(k => ["logo", "name", "search"].includes(k) || (k.startsWith("site:") && k.length < 400))
+      .slice(0, 60);
+    for (const key of keys) {
+      const l = raw.layout[key];
+      if (l) {
+        cfg.layout[key] = {
+          x: clamp(Number(l.x) || 0, -100, 100),
+          y: clamp(Number(l.y) || 0, -100, 100),
+          s: clamp(Number(l.s) || 1, 0.3, 4),
+          r: clamp(Number(l.r) || 0, -360, 360),
+        };
+      }
+    }
+  } catch (ex) {
+    // Bad or missing config: use the defaults.
+  }
+  return cfg;
+}
+
+const cfg = loadConfig();
+let saveTimer = 0;
+function save() {
+  clearTimeout(saveTimer);
+  saveTimer = setTimeout(() => {
+    Services.prefs.setStringPref(PREF, JSON.stringify(cfg));
+  }, 250);
+}
+
+const $ = id => document.getElementById(id);
+const mvNodes = () => [...document.querySelectorAll(".mv")];
+
+function applyLook() {
+  const name = $("name");
+  name.style.fontFamily = `"${cfg.font}", system-ui, sans-serif`;
+  name.style.color = cfg.nameColor;
+  document.fonts.load(`40px "${cfg.font}"`).then(fitName, fitName);
+  const box = $("logobox");
+  if (cfg.logoColor) {
+    box.classList.add("tinted");
+    box.style.setProperty("--logo", cfg.logoColor);
+    box.style.setProperty("--logo-glow", `color-mix(in srgb, ${cfg.logoColor} 55%, transparent)`);
+  } else {
+    box.classList.remove("tinted");
+    box.style.removeProperty("--logo");
+    box.style.removeProperty("--logo-glow");
+  }
+}
+
+// Wide fonts must not run off the screen: shrink the name until it fits.
+function fitName() {
+  const name = $("name");
+  name.style.fontSize = "";
+  const max = innerWidth * 0.88;
+  if (name.scrollWidth > max) {
+    const size = parseFloat(getComputedStyle(name).fontSize);
+    name.style.fontSize = `${Math.floor(size * (max / name.scrollWidth))}px`;
+  }
+}
+addEventListener("resize", fitName);
+
+function applyLayout() {
+  for (const el of mvNodes()) {
+    const l = cfg.layout[el.dataset.key] || { x: 0, y: 0, s: 1, r: 0 };
+    el.style.setProperty("--dx", l.x);
+    el.style.setProperty("--dy", l.y);
+    el.style.setProperty("--s", l.s);
+    el.style.setProperty("--r", l.r);
+  }
+}
+
+function layoutOf(key) {
+  return (cfg.layout[key] ||= { x: 0, y: 0, s: 1, r: 0 });
+}
+
+// Drag to move, corner dot to resize, top dot to rotate (Shift snaps to 15 degrees).
+function registerMv(el) {
+  for (const kind of ["size", "spin"]) {
+    const h = document.createElement("div");
+    h.className = `hdl ${kind}`;
+    h.dataset.kind = kind;
+    el.append(h);
+  }
+  el.addEventListener("click", event => {
+    if (document.body.classList.contains("editing")) {
+      event.preventDefault();
+    }
+  });
+  el.addEventListener("pointerdown", event => {
+    if (!document.body.classList.contains("editing") || event.button !== 0) {
+      return;
+    }
+    event.preventDefault();
+    const key = el.dataset.key;
+    const l0 = { ...layoutOf(key) };
+    const rect = el.getBoundingClientRect();
+    const cx = rect.left + rect.width / 2;
+    const cy = rect.top + rect.height / 2;
+    const kind = event.target.dataset?.kind || "move";
+    const d0 = Math.hypot(event.clientX - cx, event.clientY - cy) || 1;
+    const a0 = Math.atan2(event.clientY - cy, event.clientX - cx);
+    try {
+      el.setPointerCapture(event.pointerId);
+    } catch (ex) {
+      // Synthetic events in the developer check have no real pointer.
+    }
+    const move = ev => {
+      const l = layoutOf(key);
+      if (kind === "move") {
+        l.x = clamp(l0.x + ((ev.clientX - event.clientX) / innerWidth) * 100, -100, 100);
+        l.y = clamp(l0.y + ((ev.clientY - event.clientY) / innerHeight) * 100, -100, 100);
+      } else if (kind === "size") {
+        l.s = clamp(l0.s * (Math.hypot(ev.clientX - cx, ev.clientY - cy) / d0), 0.3, 4);
+      } else {
+        let r = l0.r + ((Math.atan2(ev.clientY - cy, ev.clientX - cx) - a0) * 180) / Math.PI;
+        if (ev.shiftKey) {
+          r = Math.round(r / 15) * 15;
+        }
+        l.r = ((((r + 180) % 360) + 360) % 360) - 180;
+      }
+      applyLayout();
+    };
+    const up = () => {
+      el.removeEventListener("pointermove", move);
+      el.removeEventListener("pointerup", up);
+      el.removeEventListener("pointercancel", up);
+      save();
+    };
+    el.addEventListener("pointermove", move);
+    el.addEventListener("pointerup", up);
+    el.addEventListener("pointercancel", up);
+  });
+}
+
+for (const el of mvNodes()) {
+  registerMv(el);
+}
+
+// Search box: only http(s) pages are opened directly; everything else is a search.
+$("search").addEventListener("submit", async event => {
+  event.preventDefault();
+  const q = $("q").value.trim();
+  if (!q) {
+    return;
+  }
+  let url = null;
+  if (!q.includes(" ")) {
+    try {
+      const u = new URL(q.includes("://") ? q : `https://${q}`);
+      if (/^https?:$/.test(u.protocol) && /\.[a-z]{2,}$/i.test(u.hostname)) {
+        url = u;
+      }
+    } catch (ex) {
+      url = null;
+    }
+  }
+  if (url) {
+    location.href = url.href;
+    return;
+  }
+  try {
+    const { SearchService } = ChromeUtils.importESModule("moz-src:///toolkit/components/search/SearchService.sys.mjs");
+    await SearchService.init();
+    const engine = await SearchService.getDefault();
+    location.href = engine.getSubmission(q).uri.spec;
+  } catch (ex) {
+    location.href = `https://duckduckgo.com/?q=${encodeURIComponent(q)}`;
+  }
+});
+
+let topSites = [];
+async function loadTopSites() {
+  try {
+    topSites = ((await NewTabUtils.activityStreamLinks.getTopSites({ numItems: 8 })) || [])
+      .map(l => ({ title: l.label || l.title || new URL(l.url).hostname, url: cleanUrl(l.url) }))
+      .filter(s => s.url);
+  } catch (ex) {
+    topSites = [];
+  }
+  renderSites();
+}
+
+function currentSites() {
+  if (cfg.shortcuts) {
+    return cfg.shortcuts;
+  }
+  return topSites.length ? topSites : DEFAULTS.map(([title, url]) => ({ title, url }));
+}
+
+function renderSites() {
+  if (torn) {
+    return;
+  }
+  const nav = $("sites");
+  nav.textContent = "";
+  const seen = new Map();
+  for (const s of currentSites().slice(0, 12)) {
+    const a = document.createElement("a");
+    a.className = "site mv";
+    const n = (seen.get(s.url) || 0) + 1;
+    seen.set(s.url, n);
+    a.dataset.key = `site:${s.url}${n > 1 ? `#${n}` : ""}`;
+    a.draggable = false;
+    a.href = s.url;
+    const ico = document.createElement("div");
+    ico.className = "ico";
+    ico.textContent = ((s.title || "?")[0] || "?").toUpperCase();
+    const img = document.createElement("img");
+    img.alt = "";
+    img.src = `page-icon:${s.url}`;
+    img.addEventListener("load", () => {
+      ico.textContent = "";
+      ico.append(img);
+    });
+    const t = document.createElement("span");
+    t.className = "t";
+    t.textContent = s.title || new URL(s.url).hostname;
+    a.append(ico, t);
+    nav.append(a);
+    registerMv(a);
+  }
+  applyLayout();
+}
+
+const panel = $("panel");
+function el(tag, cls, text) {
+  const n = document.createElement(tag);
+  if (cls) {
+    n.className = cls;
+  }
+  if (text !== undefined) {
+    n.textContent = text;
+  }
+  return n;
+}
+
+function row(label, ...kids) {
+  const r = el("div", "row");
+  if (label) {
+    r.append(el("label", "k", label));
+  }
+  r.append(...kids);
+  return r;
+}
+
+function button(label, onClick, cls = "") {
+  const b = el("button", cls, label);
+  b.type = "button";
+  b.addEventListener("click", onClick);
+  return b;
+}
+
+function colorInput(value, onChange) {
+  const i = document.createElement("input");
+  i.type = "color";
+  i.value = value;
+  i.addEventListener("input", () => onChange(i.value));
+  return i;
+}
+
+function buildPanel() {
+  panel.textContent = "";
+  panel.classList.remove("min");
+  const head = el("div", "head");
+  head.append(
+    el("span", "", "Customize"),
+    button("–", () => panel.classList.toggle("min"))
+  );
+  panel.append(head);
+  const body = el("div", "body");
+  const select = document.createElement("select");
+  for (const f of FONTS) {
+    const o = document.createElement("option");
+    o.value = f;
+    o.textContent = f;
+    o.style.fontFamily = `"${f}"`;
+    select.append(o);
+  }
+  select.value = cfg.font;
+  select.addEventListener("change", () => {
+    cfg.font = select.value;
+    applyLook();
+    save();
+  });
+  body.append(
+    row("Name font", select, colorInput(cfg.nameColor, v => {
+      cfg.nameColor = v;
+      applyLook();
+      save();
+    }))
+  );
+
+  const swatches = SWATCHES.map(c => {
+    const b = button("", () => {
+      cfg.logoColor = c;
+      applyLook();
+      save();
+    }, "sw");
+    b.style.background = c;
+    b.title = c;
+    return b;
+  });
+  body.append(
+    row(
+      "Logo color",
+      colorInput(cfg.logoColor || "#ff5500", v => {
+        cfg.logoColor = v;
+        applyLook();
+        save();
+      }),
+      ...swatches,
+      button("Original", () => {
+        cfg.logoColor = null;
+        applyLook();
+        save();
+      })
+    )
+  );
+
+  const list = el("div");
+  const items = () => cfg.shortcuts || currentSites().map(s => ({ ...s }));
+  const commit = arr => {
+    cfg.shortcuts = arr;
+    renderSites();
+    save();
+  };
+  const rebuild = () => {
+    list.textContent = "";
+    const arr = items();
+    arr.forEach((s, i) => {
+      const r = el("div", "sc");
+      const t = document.createElement("input");
+      t.type = "text";
+      t.className = "t";
+      t.value = s.title;
+      t.placeholder = "Name";
+      const u = document.createElement("input");
+      u.type = "text";
+      u.className = "u";
+      u.value = s.url;
+      u.placeholder = "https://...";
+      const edit = () => {
+        const url = cleanUrl(u.value);
+        u.style.borderColor = url || !u.value ? "" : "#ff5555";
+        if (url) {
+          arr[i] = { title: t.value.slice(0, 40), url };
+          commit(arr);
+        }
+      };
+      t.addEventListener("input", edit);
+      u.addEventListener("input", edit);
+      const swap = d => {
+        const j = i + d;
+        if (j >= 0 && j < arr.length) {
+          [arr[i], arr[j]] = [arr[j], arr[i]];
+          commit(arr);
+          rebuild();
+        }
+      };
+      r.append(
+        t,
+        u,
+        button("↑", () => swap(-1)),
+        button("↓", () => swap(1)),
+        button("✕", () => {
+          arr.splice(i, 1);
+          commit(arr);
+          rebuild();
+        })
+      );
+      list.append(r);
+    });
+  };
+  rebuild();
+  const controls = row(
+    "",
+    button("Add shortcut", () => {
+      const arr = items();
+      if (arr.length < 12) {
+        arr.push({ title: "New", url: "https://example.com/" });
+        commit(arr);
+        rebuild();
+      }
+    }),
+    button("Use most visited", () => {
+      cfg.shortcuts = null;
+      renderSites();
+      save();
+      rebuild();
+    })
+  );
+  const box = el("div");
+  box.style.flex = "1";
+  box.append(list, controls);
+  body.append(row("Shortcuts", box));
+
+  body.append(
+    row("", el("span", "hint", "Drag a block to move it, the corner dot to resize it, the top dot to rotate it (hold Shift to snap)."))
+  );
+  body.append(
+    row(
+      "",
+      button("Reset positions", () => {
+        cfg.layout = {};
+        applyLayout();
+        save();
+      }),
+      button("Reset everything", () => {
+        Object.assign(cfg, { font: FONTS[0], nameColor: "#ffffff", logoColor: null, shortcuts: null, layout: {} });
+        applyLook();
+        applyLayout();
+        renderSites();
+        buildPanel();
+        save();
+      }),
+      button("Done", () => setEditing(false))
+    )
+  );
+  panel.append(body);
+}
+
+function setEditing(on) {
+  document.body.classList.toggle("editing", on);
+  panel.hidden = !on;
+  if (on) {
+    buildPanel();
+  } else {
+    $("q").focus();
+  }
+}
+
+$("edit").addEventListener("click", () => setEditing(!document.body.classList.contains("editing")));
+document.addEventListener("keydown", event => {
+  if (event.key === "Escape" && document.body.classList.contains("editing")) {
+    setEditing(false);
+  }
+});
+
+// A new tab nobody is looking at keeps almost nothing: no wallpapers, no tiles.
+let torn = false;
+let tearTimer = 0;
+function tearDown() {
+  if (torn || !document.hidden || document.body.classList.contains("editing")) {
+    return;
+  }
+  torn = true;
+  for (const b of bgs) {
+    b.style.backgroundImage = "none";
+    b.classList.remove("on");
+  }
+  $("sites").textContent = "";
+}
+function rebuild() {
+  if (!torn) {
+    return;
+  }
+  torn = false;
+  next();
+  renderSites();
+}
+if (!location.hash.includes("noteardown")) {
+  document.addEventListener("visibilitychange", () => {
+    clearTimeout(tearTimer);
+    if (document.hidden) {
+      tearTimer = setTimeout(tearDown, 3000);
+    } else {
+      rebuild();
+    }
+  });
+  if (document.hidden) {
+    tearTimer = setTimeout(tearDown, 3000);
+  }
+}
+
+applyLook();
+applyLayout();
+renderSites();
+loadTopSites();
+
+if (location.hash === "#edit") {
+  setEditing(true);
+}
+
+if (Services.prefs.getBoolPref("obscurant.dev.selftest.home", false)) {
+  setTimeout(async () => {
+    const res = {};
+    setEditing(true);
+    const target = document.querySelector('.mv[data-key="name"]');
+    const r = target.getBoundingClientRect();
+    const cx = r.left + r.width / 2;
+    const cy = r.top + r.height / 2;
+    const fire = (type, x, y, on) =>
+      (on || target).dispatchEvent(
+        new PointerEvent(type, { clientX: x, clientY: y, button: 0, bubbles: true, pointerId: 1 })
+      );
+    fire("pointerdown", cx, cy);
+    fire("pointermove", cx + 110, cy + 55);
+    fire("pointerup", cx + 110, cy + 55);
+    const size = target.querySelector(".hdl.size");
+    const d = Math.hypot(r.right - cx, r.bottom - cy);
+    fire("pointerdown", r.right, r.bottom, size);
+    fire("pointermove", cx + (r.right - cx) * 1.5, cy + (r.bottom - cy) * 1.5, target);
+    fire("pointerup", cx + (r.right - cx) * 1.5, cy + (r.bottom - cy) * 1.5, target);
+    const spin = target.querySelector(".hdl.spin");
+    const sr = target.getBoundingClientRect();
+    const scx = sr.left + sr.width / 2;
+    const scy = sr.top + sr.height / 2;
+    fire("pointerdown", scx, scy - 100, spin);
+    fire("pointermove", scx + 100, scy, target);
+    fire("pointerup", scx + 100, scy, target);
+    const tile = document.querySelector(".site");
+    const tr = tile.getBoundingClientRect();
+    const tx = tr.left + tr.width / 2;
+    const ty = tr.top + tr.height / 2;
+    fire("pointerdown", tx, ty, tile);
+    fire("pointermove", tx - 150, ty - 90, tile);
+    fire("pointerup", tx - 150, ty - 90, tile);
+    await new Promise(res2 => setTimeout(res2, 600));
+    res.layoutName = cfg.layout.name;
+    res.tileLayouts = Object.keys(cfg.layout).filter(k => k.startsWith("site:")).map(k => [k, cfg.layout[k].x.toFixed(1), cfg.layout[k].y.toFixed(1)]);
+    res.savedPref = Services.prefs.getStringPref(PREF, "");
+    res.d = d;
+    await IOUtils.writeUTF8(PathUtils.join(PathUtils.profileDir, "obscurant-home-selftest.json"), JSON.stringify(res, null, 1));
+    Services.startup.quit(Ci.nsIAppStartup.eForceQuit);
+  }, 2500);
+}
