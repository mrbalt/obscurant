+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Update notices. About once a day the browser fetches one small file, signed with the
+ * project's key, and says so if a newer version exists. It never downloads or installs
+ * anything: you install through your package manager. The request carries no cookies, no
+ * referrer and nothing about you or your browsing. Does nothing until an address is set. */
+
+import { setTimeout, clearTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+const ON = "obscurant.update.enabled";
+const URL_PREF = "obscurant.update.url";
+const KEY_PREF = "obscurant.update.pubkey";
+const BUILD_PREF = "obscurant.update.build";
+const LAST_PREF = "obscurant.update.last_check";
+const SKIP_PREF = "obscurant.update.skip";
+const FOUND_PREF = "obscurant.update.found";
+const DAY_MS = 22 * 3600 * 1000;
+const MAX_BYTES = 8192;
+const NOTE = "obscurant-update";
+
+function b64(text) {
+  const bin = atob(text);
+  return Uint8Array.from(bin, c => c.charCodeAt(0));
+}
+
+export const ObscurantUpdate = {
+  _timer: 0,
+  _inited: false,
+
+  init() {
+    if (this._inited) {
+      return;
+    }
+    this._inited = true;
+    this._schedule(Services.prefs.getIntPref("obscurant.update.first_delay_s", 240) * 1000);
+  },
+
+  _schedule(ms) {
+    clearTimeout(this._timer);
+    this._timer = setTimeout(async () => {
+      try {
+        await this.check({ manual: false });
+      } catch (ex) {
+        console.error("ObscurantUpdate:", ex);
+      }
+      this._schedule(DAY_MS / 2);
+    }, ms);
+  },
+
+  _message(m) {
+    return [m.version, m.build, m.released, m.url, m.notes].join("\n");
+  },
+
+  async verify(manifest) {
+    const keyText = Services.prefs.getStringPref(KEY_PREF, "");
+    if (!keyText || !manifest || typeof manifest.sig !== "string") {
+      return false;
+    }
+    if (typeof manifest.version !== "string" || !/^\d+(\.\d+){1,3}$/.test(manifest.version)) {
+      return false;
+    }
+    if (!Number.isInteger(manifest.build) || typeof manifest.url !== "string" || typeof manifest.notes !== "string") {
+      return false;
+    }
+    try {
+      const key = await crypto.subtle.importKey("raw", b64(keyText), { name: "Ed25519" }, false, ["verify"]);
+      const data = new TextEncoder().encode(this._message(manifest));
+      return await crypto.subtle.verify({ name: "Ed25519" }, key, b64(manifest.sig), data);
+    } catch (ex) {
+      return false;
+    }
+  },
+
+  // The download page must be on the same site as the update address.
+  _sameSite(downloadUrl, updateUrl) {
+    try {
+      const a = new URL(downloadUrl);
+      const b = new URL(updateUrl);
+      return a.protocol === "https:" && (a.hostname === b.hostname || a.hostname === "github.com");
+    } catch (ex) {
+      return false;
+    }
+  },
+
+  isNewer(manifest) {
+    const cmp = Services.vc.compare(manifest.version, Services.appinfo.version);
+    return cmp > 0 || (cmp === 0 && manifest.build > Services.prefs.getIntPref(BUILD_PREF, 1));
+  },
+
+  // Returns {state: "off"|"no-address"|"current"|"available"|"bad-signature"|"error", ...}
+  async check({ manual = false } = {}) {
+    if (!manual && !Services.prefs.getBoolPref(ON, true)) {
+      return { state: "off" };
+    }
+    const address = Services.prefs.getStringPref(URL_PREF, "");
+    if (!address) {
+      return { state: "no-address" };
+    }
+    let parsed;
+    try {
+      parsed = new URL(address);
+    } catch (ex) {
+      return { state: "error", detail: "bad address" };
+    }
+    const local = ["127.0.0.1", "localhost"].includes(parsed.hostname) && Services.prefs.getBoolPref("obscurant.dev.update_local", false);
+    if (parsed.protocol !== "https:" && !local) {
+      return { state: "error", detail: "the update address must be https" };
+    }
+    if (!manual) {
+      const last = Date.parse(Services.prefs.getStringPref(LAST_PREF, "")) || 0;
+      if (Date.now() - last < DAY_MS) {
+        return { state: "current", detail: "checked recently" };
+      }
+    }
+    let text;
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 30000);
+    try {
+      const res = await fetch(address, {
+        credentials: "omit",
+        cache: "no-store",
+        referrerPolicy: "no-referrer",
+        signal: controller.signal,
+      });
+      if (!res.ok) {
+        return { state: "error", detail: `server said ${res.status}` };
+      }
+      text = await res.text();
+    } catch (ex) {
+      return { state: "error", detail: "could not reach the update address" };
+    } finally {
+      clearTimeout(timer);
+    }
+    Services.prefs.setStringPref(LAST_PREF, new Date().toISOString());
+    if (text.length > MAX_BYTES) {
+      return { state: "error", detail: "reply too large" };
+    }
+    let manifest;
+    try {
+      manifest = JSON.parse(text);
+    } catch (ex) {
+      return { state: "error", detail: "reply was not understood" };
+    }
+    if (!(await this.verify(manifest)) || !this._sameSite(manifest.url, address)) {
+      Services.prefs.clearUserPref(FOUND_PREF);
+      return { state: "bad-signature" };
+    }
+    if (!this.isNewer(manifest)) {
+      Services.prefs.clearUserPref(FOUND_PREF);
+      return { state: "current", version: manifest.version };
+    }
+    Services.prefs.setStringPref(FOUND_PREF, JSON.stringify({ version: manifest.version, build: manifest.build, url: manifest.url, notes: manifest.notes.slice(0, 300) }));
+    if (manual || Services.prefs.getStringPref(SKIP_PREF, "") !== `${manifest.version}.${manifest.build}`) {
+      this.notify(manifest);
+    }
+    return { state: "available", version: manifest.version, build: manifest.build, url: manifest.url };
+  },
+
+  found() {
+    try {
+      return JSON.parse(Services.prefs.getStringPref(FOUND_PREF, "") || "null");
+    } catch (ex) {
+      return null;
+    }
+  },
+
+  notify(manifest) {
+    const { BrowserWindowTracker } = ChromeUtils.importESModule("resource:///modules/BrowserWindowTracker.sys.mjs");
+    const win = BrowserWindowTracker.getTopWindow({ allowPopups: false });
+    if (!win || win.gNotificationBox.getNotificationWithValue(NOTE)) {
+      return;
+    }
+    const label = `A new version of Obscurant is out (${manifest.version}, build ${manifest.build}). Security fixes only arrive when you update.`;
+    win.gNotificationBox.appendNotification(
+      NOTE,
+      { label, priority: win.gNotificationBox.PRIORITY_INFO_HIGH },
+      [
+        {
+          label: "See what is new",
+          callback: () => {
+            win.openTrustedLinkIn(manifest.url, "tab");
+            return false;
+          },
+        },
+        {
+          label: "Skip this version",
+          callback: () => {
+            Services.prefs.setStringPref(SKIP_PREF, `${manifest.version}.${manifest.build}`);
+            return false;
+          },
+        },
+      ]
+    );
+  },
+};
