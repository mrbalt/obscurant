+      for (const [p, v] of Object.entries(turnedOn ? also.on : also.off)) {
+        writePref(p, v);
+      }
+    }
+    sync();
+  });
+  sync();
+  watch(pref, sync);
+  return row(label, desc, sw, keywords);
