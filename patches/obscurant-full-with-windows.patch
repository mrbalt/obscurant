+    this._say("Search is not available right now");
+  },
+
+  shortcuts() {
+    try {
+      const raw = JSON.parse(Services.prefs.getStringPref("obscurant.voice.shortcuts", "{}"));
+      return raw && typeof raw === "object" && !Array.isArray(raw) ? raw : {};
+    } catch (ex) {
+      return {};
+    }
+  },
+
+  setShortcuts(map) {
+    const clean = {};
+    for (const [name, url] of Object.entries(map).slice(0, 50)) {
+      const key = String(name).toLowerCase().replace(/[^a-z0-9 ]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 30);
+      try {
+        const u = new URL(String(url));
+        if (key && /^https?:$/.test(u.protocol) && u.href.length <= 600) {
+          clean[key] = u.href;
+        }
+      } catch (ex) {
+        // Not a web address.
+      }
+    }
+    Services.prefs.setStringPref("obscurant.voice.shortcuts", JSON.stringify(clean));
+  },
+
+  _newTabShortcuts() {
+    try {
+      const cfg = JSON.parse(Services.prefs.getStringPref("obscurant.newtab.config", "{}"));
+      return Array.isArray(cfg.shortcuts) ? cfg.shortcuts.filter(s => s && s.title && s.url) : [];
+    } catch (ex) {
+      return [];
+    }
+  },
+
+  async _vocab() {
+    const names = [...Object.keys(this.shortcuts()), ...this._newTabShortcuts().map(s => String(s.title))];
+    try {
+      const marks = await lazy.PlacesUtils.bookmarks.search({});
+      names.push(...marks.slice(0, 15).map(b => b.title).filter(Boolean));
+    } catch (ex) {
+      // No bookmarks yet.
+    }
+    return [...new Set(names.map(n => n.replace(/[^A-Za-z0-9 ]+/g, " ").replace(/\s+/g, " ").trim()).filter(n => n.length >= 2 && n.length <= 30))].join(". ").slice(0, 260);
+  },
+
+  // Looks a spoken name up in: your voice shortcuts, your new-tab shortcuts, well-known sites,
+  // your bookmarks, then places you have been.
+  async _resolveName(spoken) {
+    const name = spoken.replace(/^(?:my|the)\s+/, "").replace(/\s+(?:website|site|page|bookmark|shortcut|app)$/, "").trim();
+    const best = (entries, floor) => {
+      let top = null;
+      let score = 0;
+      for (const [key, url] of entries) {
+        const k = key.toLowerCase();
+        const r = k === name ? 1 : k.includes(name) || name.includes(k) ? 0.9 : ratio(k, name);
+        if (r > score) {
+          score = r;
+          top = url;
+        }
+      }
+      return score >= floor ? top : null;
+    };
+    const mine = best(Object.entries(this.shortcuts()), 0.8);
+    if (mine) {
+      return { url: mine, known: true };
+    }
+    const tiles = best(this._newTabShortcuts().map(s => [String(s.title), String(s.url)]), 0.8);
+    if (tiles) {
+      return { url: tiles, known: true };
+    }
+    const squashed = name.replace(/ dot /g, ".").replace(/\s+/g, "");
+    if (SITES[squashed]) {
+      return { url: `https://${SITES[squashed]}/`, known: false, host: SITES[squashed] };
+    }
+    try {
+      const marks = (await lazy.PlacesUtils.bookmarks.search({ query: name })).filter(b => /^https?:/.test(String(b.url)));
+      if (marks.length) {
+        return { url: String(marks[0].url), known: true };
+      }
+      const db = await lazy.PlacesUtils.promiseDBConnection();
+      const like = `%${name.replace(/[%_]/g, "")}%`;
+      const rows = await db.executeCached(
+        "SELECT url FROM moz_places WHERE visit_count > 0 AND (title LIKE :q OR url LIKE :q) AND (url LIKE 'https://%' OR url LIKE 'http://%') ORDER BY frecency DESC LIMIT 1",
+        { q: like }
+      );
+      if (rows.length) {
+        return { url: rows[0].getResultByName("url"), known: true };
+      }
+    } catch (ex) {
+      // No library yet.
+    }
+    if (HOST.test(squashed)) {
+      return { url: `https://${squashed}/`, known: false, host: squashed };
+    }
+    return null;
+  },
+
+  _openUrl(win, url) {
+    const here = win.gBrowser.currentURI.spec;
+    win.openTrustedLinkIn(url, ["about:blank", "about:home", "about:newtab"].includes(here) ? "current" : "tab");
+  },
+
+  // "open youtube", "open gmail", "open work", "open example dot com". A site you have never
+  // visited has to be confirmed out loud, so a stray sound cannot send you somewhere new.
+  async _open(win, spoken) {
+    const found = await this._resolveName(spoken);
+    if (!found) {
+      return this._search(win, spoken);
+    }
+    const go = () => this._openUrl(win, found.url);
+    if (found.known || !Services.prefs.getBoolPref(CONFIRM, true) || (await this._visited(found.host))) {
+      return go();
+    }
+    this._pending = { until: Date.now() + 9000, run: go };
+    this._arm(9);
+    this._say(`Open ${found.host}? Say "yes".`);
+    return undefined;
+  },
+
+  _guess(text) {
+    let best = { score: 0, phrase: "" };
+    for (const phrase of SIMPLE) {
+      const score = ratio(text, phrase);
+      if (score > best.score) {
+        best = { score, phrase };
+      }
+    }
+    return best;
+  },
+
+  async _visited(host) {
+    try {
+      const uri = Services.io.newURI(`https://${host.split("/")[0]}/`);
+      const rev = lazy.PlacesUtils.getReversedHost(uri);
+      const db = await lazy.PlacesUtils.promiseDBConnection();
+      const rows = await db.executeCached("SELECT 1 FROM moz_places WHERE rev_host = :rev LIMIT 1", { rev });
+      return rows.length > 0;
+    } catch (ex) {
+      return false;
+    }
+  },
+};
