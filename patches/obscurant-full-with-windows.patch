+function primaryPasswordDialog(mode, onDone) {
+  const { PrimaryPassword: pp } = ChromeUtils.importESModule(
+    "resource:///modules/ObscurantPrimaryPassword.sys.mjs"
+  );
+  const field = (label, extra = {}) => {
+    const input = el("input", { type: "password", autocomplete: "new-password", ...extra });
+    return [el("label", { text: label }), input, input];
+  };
+  const [curLabel, , cur] = field("Current primary password", { autocomplete: "current-password" });
+  const [newLabel, , one] = field("New primary password");
+  const [againLabel, , two] = field("Type it again");
+  const meterBar = el("span");
+  const meter = el("div", { class: "pp-meter" }, meterBar);
+  const meterText = el("div", { class: "pp-note" });
+  const ask = el(
+    "select",
+    {},
+    ...[
+      ["5", "after 5 minutes"],
+      ["15", "after 15 minutes"],
+      ["60", "after an hour"],
+      ["-1", "once each time the browser starts"],
+      ["0", "every time"],
+    ].map(([v, l]) => el("option", { value: v, text: l }))
+  );
+  ask.value = "15";
+  const error = el("div", { class: "pp-error", "aria-live": "polite" });
+  const submitLabel = { set: "Set password", change: "Change password", remove: "Remove password" }[mode];
+  const title = { set: "Set a primary password", change: "Change the primary password", remove: "Remove the primary password" }[mode];
+  const text = {
+    set: "One password that locks all your saved passwords. Without it the stored files cannot be read. If you forget it, the saved passwords cannot be recovered.",
+    change: "Choose a new password. The saved passwords are re-locked with it.",
+    remove: "Your saved passwords will be stored without that lock, and saving new ones is turned off. Anyone using this computer could read them.",
+  }[mode];
+  const body = [el("h2", { text: title }), el("p", { text })];
+  if (mode !== "set") {
+    body.push(curLabel, cur);
+  }
+  if (mode !== "remove") {
+    body.push(newLabel, one, meter, meterText, againLabel, two, el("label", { text: "Ask for it again" }), ask);
+  }
+  const cancel = el("button", { class: "btn", type: "button", text: "Cancel" });
+  const save = el("button", { class: mode === "remove" ? "btn danger" : "btn primary", type: "submit", text: submitLabel });
+  const form = el("form", { class: "pp-card", autocomplete: "off" }, ...body, error, el("div", { class: "pp-actions" }, cancel, save));
+  const overlay = el("div", { class: "pp-overlay" }, form);
+  const close = () => overlay.remove();
+  cancel.addEventListener("click", close);
+  overlay.addEventListener("keydown", event => {
+    if (event.key === "Escape") {
+      close();
+    }
+  });
+  one.addEventListener("input", () => {
+    const { score, label, bits } = pp.strength(one.value);
+    meter.dataset.level = String(one.value.length < pp.MIN_LENGTH ? 0 : score);
+    meterBar.style.width = one.value ? `${Math.min(100, Math.max(12, bits))}%` : "0";
+    meterText.textContent = one.value ? `${label}. At least ${pp.MIN_LENGTH} characters; a few random words in a row works well.` : "";
+  });
+  form.addEventListener("submit", event => {
+    event.preventDefault();
+    if (mode !== "remove" && one.value !== two.value) {
+      error.textContent = "The two passwords do not match.";
+      return;
+    }
+    const minutes = parseInt(ask.value, 10);
+    const result =
+      mode === "set" ? pp.set(one.value, minutes) : mode === "change" ? pp.change(cur.value, one.value, minutes) : pp.remove(cur.value);
+    if (!result.ok) {
+      error.textContent = result.error;
+      return;
+    }
+    if (mode === "remove") {
+      writePref("signon.rememberSignons", false);
+    }
+    close();
+    toast(mode === "remove" ? "Primary password removed" : "Primary password saved");
+    onDone?.();
+  });
+  document.body.append(overlay);
+  (mode === "set" ? one : cur).focus();
+}
