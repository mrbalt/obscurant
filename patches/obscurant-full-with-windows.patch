+      return "ok";
+    }
+    if ((m = text.match(/^convert (.+?) (.+?) (?:to|into|in) (.+)$/))) {
+      const value = parseNumber(m[1]);
+      const out = Number.isNaN(value) ? null : convertUnits(value, m[2], m[3]);
+      if (out === null) {
+        say("I can convert length, weight, volume, speed and temperature, like \"convert 5 miles to kilometers\"");
+        return "refused";
+      }
+      say(`${m[1]} ${m[2]} is about ${Math.round(out * 100) / 100} ${m[3]}`);
+      return "ok";
+    }
